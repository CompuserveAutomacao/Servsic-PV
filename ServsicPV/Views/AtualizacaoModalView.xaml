<UserControl
    x:Class="ServsicPV.Views.AtualizacaoModalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
        <!-- Fundo Escurecido Modal Backdrop -->
        <Border Background="#80000000"/>

        <!-- Janela Modal Centralizada -->
        <Border Background="#FFFFFF"
                CornerRadius="12"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                Width="520"
                MaxHeight="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Cabeçalho Navy -->
                    <RowDefinition Height="*"/>    <!-- Conteúdo / Changelog -->
                    <RowDefinition Height="Auto"/> <!-- Rodapé de Ações / Download -->
                </Grid.RowDefinitions>

                <!-- 1. Cabeçalho Navy Corporativo -->
                <Border Grid.Row="0" Background="{StaticResource BrushServsicDark}" CornerRadius="12,12,0,0" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="6" Padding="6">
                                <ic:SymbolIcon Symbol="ArrowSync" Foreground="{StaticResource BrushServsicBlueLight}" FontSize="18"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ATUALIZAÇÃO DISPONÍVEL" FontSize="14" FontFamily="Segoe UI Semibold" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Uma nova versão do SERVSIC PV está pronta para instalação" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding FecharCommand}" 
                                IsEnabled="{Binding CanClose}"
                                Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="6"
                                ToolTipService.ToolTip="Fechar (Esc)">
                            <ic:SymbolIcon Symbol="Dismiss" Foreground="#94A3B8" FontSize="16"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Conteúdo Central -->
                <ScrollViewer Grid.Row="1" Padding="20,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <!-- Badges de Versão (Atual -> Nova) -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="VERSÃO ATUAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}"/>
                                    <TextBlock Text="{Binding CurrentVersion}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>

                                <ic:SymbolIcon Grid.Column="1" Symbol="ArrowRight" FontSize="16" Foreground="{StaticResource BrushServsicBlue}" VerticalAlignment="Center" Margin="12,0"/>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="NOVA VERSÃO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                    <TextBlock Text="{Binding NewVersion}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Novidades e Changelog -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="Sparkle" FontSize="14" Foreground="{StaticResource BrushServsicBlue}"/>
                                <TextBlock Text="Novidades e melhorias desta versão:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                            </StackPanel>

                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" MinHeight="100" MaxHeight="180">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding Changelog}" FontSize="12" Foreground="{StaticResource BrushTextDark}" TextWrapping="Wrap" LineHeight="18"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Mensagem de Erro (se houver) -->
                        <Border Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                                Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="Warning" FontSize="16" Foreground="#DC2626" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Progresso do Download -->
                        <StackPanel Spacing="8" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8" CornerRadius="4" Foreground="{StaticResource BrushServsicBlue}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushServsicBlue}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Rodapé de Ações -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="18,12" CornerRadius="0,0,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Informação de segurança -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="ShieldCheckmark" FontSize="14" Foreground="{StaticResource BrushSuccess}"/>
                            <TextBlock Text="Conexão e dados protegidos" FontSize="11" Foreground="{StaticResource BrushTextSubtle}"/>
                        </StackPanel>

                        <!-- Botão Lembrar Mais Tarde -->
                        <Button Grid.Column="1" 
                                Command="{Binding FecharCommand}" 
                                IsEnabled="{Binding CanClose}"
                                Style="{StaticResource BtnSecondary}" 
                                Height="36" 
                                Margin="0,0,10,0">
                            <TextBlock Text="Lembrar Mais Tarde"/>
                        </Button>

                        <!-- Botão Atualizar Agora -->
                        <Button Grid.Column="2" 
                                Command="{Binding AtualizarCommand}" 
                                IsEnabled="{Binding CanClose}"
                                Style="{StaticResource BtnPrimary}" 
                                Height="36" 
                                Padding="18,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="ArrowDownload" FontSize="15"/>
                                <TextBlock Text="Atualizar Agora"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
