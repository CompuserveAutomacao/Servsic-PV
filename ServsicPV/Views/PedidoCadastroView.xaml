<UserControl
    x:Class="ServsicPV.Views.PedidoCadastroView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:views="using:ServsicPV.Views"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BrushIceBackground}" Padding="18,14">
        <!-- Layout Principal: 2 Colunas (Esquerda = Operação / Direita = Resumo Financeiro Vertical) -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- COLUNA ESQUERDA: CLIENTE E PRODUTOS       -->
            <!-- ========================================== -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0. Card Compacto de Cliente -->
                    <RowDefinition Height="*"/>    <!-- 1. Grade de Produtos e Inserção de Itens -->
                </Grid.RowDefinitions>

                <!-- 0. Card de Identificação do Cliente -->
                <Border Grid.Row="0" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Cabeçalho do Card -->
                            <RowDefinition Height="Auto"/> <!-- Conteúdo (Busca ou Cliente Selecionado) -->
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho do Card de Cliente -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Person" FontSize="18" Foreground="{StaticResource BrushServsicBlue}"/>
                            <TextBlock Text="Cliente" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                        </StackPanel>

                        <!-- Conteúdo: ESTADO A ou ESTADO B -->
                        <Grid Grid.Row="1">
                            <!-- ESTADO A: Nenhum cliente selecionado (Campo de Pesquisa + Ações) -->
                            <Grid Visibility="{Binding HasClienteSelecionado, Converter={StaticResource InverseBoolToVisibilityConverter}}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Input de Busca Rápida -->
                                <TextBox Grid.Column="0"
                                         x:Name="TxtFiltroCliente"
                                         Text="{Binding FiltroCliente, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="FiltroCliente_KeyDown"
                                         PlaceholderText="Digite Código, CPF/CNPJ ou Nome do Cliente e aperte Enter ou F3..."
                                         Height="38"
                                         VerticalAlignment="Center"/>

                                <!-- Botão Buscar com Atalho F3 -->
                                <Button Grid.Column="1" Command="{Binding BuscarClienteRapidoCommand}" Style="{StaticResource BtnPrimary}" Height="38" Padding="16,0" ToolTipService.ToolTip="Buscar ou Consultar Clientes (F3)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="Search" FontSize="16"/>
                                        <TextBlock Text="Buscar (F3)" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Botão Cadastrar Rápido -->
                                <Button Grid.Column="2" Command="{Binding AbrirCadastroRapidoClienteCommand}" Style="{StaticResource BtnSecondary}" Height="38" Padding="14,0" ToolTipService.ToolTip="Cadastro Rápido de Novo Cliente">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="Add" FontSize="16" Foreground="{StaticResource BrushServsicBlue}"/>
                                        <TextBlock Text="Novo Cliente" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- ESTADO B: Cliente Selecionado (Exibição Elegante dos Dados + Crédito + Botão Trocar) -->
                            <Grid Visibility="{Binding HasClienteSelecionado, Converter={StaticResource BoolToVisibilityConverter}}" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ícone do Cliente -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource BrushServsicBlueSoft}" VerticalAlignment="Center">
                                    <ic:SymbolIcon Symbol="Person" FontSize="20" Foreground="{StaticResource BrushServsicBlue}"/>
                                </Border>

                                <!-- Dados Cadastrais do Cliente -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Pedido.Cliente}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSubtle}">
                                                <Run Text="Cód: "/><Run Text="{Binding Pedido.LkCliente}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{Binding Pedido.DocFormatado}" FontSize="12" Foreground="{StaticResource BrushTextSubtle}"/>
                                        <TextBlock Text="{Binding Pedido.TelFormatado}" FontSize="12" Foreground="{StaticResource BrushTextSubtle}"/>
                                        <TextBlock Text="{Binding Pedido.CidadeFormatada}" FontSize="12" Foreground="{StaticResource BrushTextSubtle}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- DADOS DE CRÉDITO E STATUS A PRAZO (Como no ERP Legado) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <!-- Limite de Crédito a Prazo -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <TextBlock Text="LIMITE A PRAZO:" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedCliente.LimiteFormatado}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Se tiver dívida aberta, mostra saldo devedor/disponível -->
                                        <TextBlock FontSize="10.5" HorizontalAlignment="Right"
                                                   Visibility="{Binding SelectedCliente.HasDividaAberta, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Run Text="Devedor: "/><Run Text="{Binding SelectedCliente.SaldoDevedorFormatado}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            <Run Text=" | Disp: "/><Run Text="{Binding SelectedCliente.DisponivelFormatado}" FontWeight="SemiBold" Foreground="{StaticResource BrushServsicBlue}"/>
                                        </TextBlock>

                                        <!-- Alerta se houver títulos vencidos em atraso -->
                                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Right"
                                                   Visibility="{Binding SelectedCliente.HasTitulosVencidos, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Run Text="Vencido: "/><Run Text="{Binding SelectedCliente.TotalVencidoFormatado}"/>
                                            <Run Text=" ("/><Run Text="{Binding SelectedCliente.TitulosVencidos}"/><Run Text=" tit.)"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Badge de Situação a Prazo: DESBLOQUEADO / LIBERADO -->
                                    <Border CornerRadius="6" Padding="10,6" VerticalAlignment="Center"
                                            Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                                            Visibility="{Binding SelectedCliente.IsBloqueado, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="{Binding SelectedCliente.StatusCreditoDescricao}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="15" Foreground="{StaticResource BrushServsicBlue}"/>
                                            <TextBlock Text="DESBLOQUEADO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Badge de Situação a Prazo: BLOQUEADO -->
                                    <Border CornerRadius="6" Padding="10,6" VerticalAlignment="Center"
                                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                            Visibility="{Binding SelectedCliente.IsBloqueado, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="{Binding SelectedCliente.StatusCreditoDescricao}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <ic:SymbolIcon Symbol="LockClosed" FontSize="15" Foreground="{StaticResource BrushDanger}"/>
                                            <TextBlock Text="BLOQUEADO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushDanger}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Botões de Ação para Cliente Selecionado -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Command="{Binding AbrirConsultaClienteCommand}" Style="{StaticResource BtnSecondary}" Height="34" Padding="10,0" ToolTipService.ToolTip="Trocar Cliente">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Symbol="ArrowSync" FontSize="14" Foreground="{StaticResource BrushServsicBlue}"/>
                                            <TextBlock Text="Trocar" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LimparClienteCommand}" Style="{StaticResource BtnSecondary}" Height="34" Padding="8,0" ToolTipService.ToolTip="Limpar Cliente">
                                        <ic:SymbolIcon Symbol="Dismiss" FontSize="14" Foreground="{StaticResource BrushDanger}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 1. Grade de Produtos e Inserção de Itens (Fundo Azul Suave) -->
                <Border Grid.Row="1" Background="#F0F7FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 0. Cabeçalho do Card -->
                            <RowDefinition Height="Auto"/> <!-- 1. Barra Rápida de Produto -->
                            <RowDefinition Height="Auto"/> <!-- 2. Faixa Informativa da Margem de Desconto -->
                            <RowDefinition Height="Auto"/> <!-- 3. Cabeçalho Fixo da Grade de Itens -->
                            <RowDefinition Height="*"/>    <!-- 4. Lista de Itens com Rolagem -->
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho do Card de Produtos com Botão F4 - ITENS em Destaque -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ic:SymbolIcon Symbol="Box" FontSize="18" Foreground="{StaticResource BrushServsicBlue}"/>
                                <TextBlock Text="Produtos / Itens do Pedido" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                            </StackPanel>

                            <!-- Botão F4 - ITENS (Fonte Segoe UI Semibold, Contraste Perfeito no Foco/Hover) -->
                            <Button Grid.Column="1" 
                                    Command="{Binding AbrirConsultaProdutoCommand}" 
                                    IsTabStop="False"
                                    Height="34" 
                                    Padding="14,0" 
                                    CornerRadius="6"
                                    BorderThickness="1.5"
                                    BorderBrush="{StaticResource BrushServsicBlue}"
                                    Background="#FFFFFF"
                                    Foreground="{StaticResource BrushServsicBlue}">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E0F2FE"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#BAE6FD"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundFocused" Color="#E0F2FE"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#0284C7"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#0284C7"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#0369A1"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushFocused" Color="#0284C7"/>
                                    <SolidColorBrush x:Key="ButtonForeground" Color="#0284C7"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#0284C7"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#0369A1"/>
                                    <SolidColorBrush x:Key="ButtonForegroundFocused" Color="#0284C7"/>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ic:SymbolIcon Symbol="Search" FontSize="15" Foreground="{StaticResource BrushServsicBlue}"/>
                                    <TextBlock Text="F4 - ITENS" FontFamily="Segoe UI Semibold" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushServsicBlue}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Barra de Inserção de Produto -->
                        <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/> <!-- Código / Barra -->
                                <ColumnDefinition Width="*"/>   <!-- Descrição do Produto -->
                                <ColumnDefinition Width="100"/> <!-- Preço Unitário -->
                                <ColumnDefinition Width="75"/>  <!-- Qtd -->
                                <ColumnDefinition Width="130"/> <!-- Desconto (% / R$) -->
                                <ColumnDefinition Width="Auto"/><!-- Inserir -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Código / Barra" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                <TextBox x:Name="TxtCodigoProduto"
                                         Text="{Binding CodigoProdutoInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="CodigoProduto_KeyDown"
                                         PlaceholderText="Bipe ou digite..."
                                         Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Descrição do Produto" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                <TextBox Text="{Binding ProdutoSelecionado.Descricao, Mode=OneWay}"
                                         IsReadOnly="True"
                                         IsTabStop="False"
                                         PlaceholderText="Produto localizado..."
                                         Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Unitário" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                <TextBox Text="{Binding PrecoUnitarioTexto, Mode=OneWay}"
                                         IsReadOnly="True"
                                         IsTabStop="False"
                                         Background="#F8FAFC"
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource BrushTextDark}"
                                         PlaceholderText="R$ 0,00"
                                         Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Text="Qtd" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                <TextBox x:Name="TxtQuantidade"
                                         Text="{Binding QuantidadeTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="Quantidade_KeyDown"
                                         BeforeTextChanging="DecimalOnly_BeforeTextChanging"
                                         Height="36"/>
                            </StackPanel>

                            <!-- Desconto Unificado com Alternância % e R$ -->
                            <StackPanel Grid.Column="4" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Desconto (" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                    <TextBlock Text="{Binding TipoDescontoItemSimbolo}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                    <TextBlock Text=")" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDescontoItem"
                                             Grid.Column="0"
                                             Text="{Binding DescontoItemInputTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="DescontoItem_KeyDown"
                                             BeforeTextChanging="DecimalOnly_BeforeTextChanging"
                                             PlaceholderText="0,00"
                                             Height="36"/>
                                    <Button x:Name="BtnToggleTipoDescontoItem"
                                             Grid.Column="1"
                                             Command="{Binding AlternarTipoDescontoItemCommand}"
                                             Content="{Binding TipoDescontoItemSimbolo}"
                                             FontWeight="Bold"
                                             FontSize="11.5"
                                             Height="36"
                                             Width="38"
                                             Padding="0"
                                             Background="{StaticResource BrushServsicBlueSoft}"
                                             Foreground="{StaticResource BrushServsicBlue}"
                                             BorderBrush="{StaticResource BrushServsicBlue}"
                                             BorderThickness="1"
                                             ToolTipService.ToolTip="Alternar Desconto entre % e R$"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                                <Button x:Name="BtnInserirItem"
                                        IsEnabled="{Binding HasProdutoSelecionado}"
                                        Click="BtnInserirItem_Click"
                                        KeyDown="BtnInserirItem_KeyDown"
                                        Style="{StaticResource BtnPrimary}"
                                        Height="36" Padding="16,0"
                                        ToolTipService.ToolTip="Adicionar Item (Enter)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="Add" FontSize="16"/>
                                        <TextBlock Text="Inserir" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Faixa Informativa: Margem de Desconto Restante para o Vendedor Ofertar -->
                        <Border Grid.Row="2" 
                                Visibility="{Binding HasMargemDescontoItemVisivel, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6"
                                Padding="12,6" Margin="0,-4,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ic:SymbolIcon Symbol="Tag" FontSize="15" Foreground="{Binding BrushMargemDescontoItem}"/>
                                    <TextBlock Text="MARGEM DE DESCONTO:" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TextoMargemDescontoItemRestante}" 
                                               FontSize="12" FontWeight="Bold" 
                                               Foreground="{Binding BrushMargemDescontoItem}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding LimiteDescontoItemInfo}" 
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSubtle}" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Cabeçalho Superior Imitando Título de Grid (Card Header) -->
                        <Border Grid.Row="3" Background="{StaticResource BrushServsicDark}" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,4,0,2">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/> <!-- CÓDIGO -->
                                    <ColumnDefinition Width="*"/>   <!-- DESCRIÇÃO -->
                                    <ColumnDefinition Width="38"/>  <!-- UN -->
                                    <ColumnDefinition Width="45"/>  <!-- QTD -->
                                    <ColumnDefinition Width="80"/>  <!-- UNITÁRIO -->
                                    <ColumnDefinition Width="72"/>  <!-- DESCONTO -->
                                    <ColumnDefinition Width="85"/>  <!-- TOTAL -->
                                    <ColumnDefinition Width="36"/>  <!-- AÇÕES -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CÓDIGO" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="DESCRIÇÃO DO PRODUTO" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="UN" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="QTD" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="UNITÁRIO" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="DESCONTO" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="TOTAL" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="" FontSize="11"/>
                            </Grid>
                        </Border>

                        <!-- Lista de Cards Virtuais de Itens (Alta Performance com Virtualização de Containers) -->
                        <ListView x:Name="ListaItens"
                                  Grid.Row="4"
                                  ItemsSource="{Binding Pedido.Itens}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  ShowsScrollingPlaceholders="False"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollMode="Enabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Vertical" CacheLength="4"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="44"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" 
                                            BorderBrush="#E2E8F0" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="12,8" 
                                            Margin="0,0,0,6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="85"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 0. Código -->
                                            <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CodigoExibicao}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </Border>

                                            <!-- 1. Descrição do Produto -->
                                            <TextBlock Grid.Column="1" Text="{Binding Produto}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- 2. Unidade -->
                                            <TextBlock Grid.Column="2" Text="{Binding Unidade}" FontSize="12" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                            <!-- 3. Quantidade -->
                                            <Border Grid.Column="3" Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Quantidade}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                            </Border>

                                            <!-- 4. Preço Unitário -->
                                            <TextBlock Grid.Column="4" Text="{Binding VlUnitario, Converter={StaticResource CurrencyConverter}}" FontSize="12" Foreground="{StaticResource BrushTextDark}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <!-- 5. Desconto com Badge Interativo e Flyout Compacto -->
                                            <Button Grid.Column="5" 
                                                    Click="BtnAbrirEdicaoDesconto_Click"
                                                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                                    CornerRadius="4" Padding="5,1" Height="24" MinWidth="0" MinHeight="0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    ToolTipService.ToolTip="Clique para alterar o desconto deste item">
                                                <Grid ColumnSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding DescontoFormatado}" 
                                                               FontSize="11" FontWeight="SemiBold" 
                                                               Foreground="{StaticResource BrushDanger}" 
                                                               VerticalAlignment="Center"/>
                                                    <ic:SymbolIcon Grid.Column="1" Symbol="Edit" FontSize="10" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Button.Flyout>
                                                    <Flyout x:Name="FlyoutEdicaoDesconto">
                                                        <StackPanel Width="260" Spacing="10" Padding="4">
                                                            <TextBlock Text="Alterar Desconto do Item" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextDark}"/>
                                                            
                                                            <TextBlock FontSize="11.5" Foreground="{StaticResource BrushTextSubtle}" TextWrapping="Wrap">
                                                                <Run Text="Produto: "/><Run Text="{Binding Produto}" FontWeight="SemiBold"/>
                                                                <LineBreak/>
                                                                <Run Text="Subtotal: "/><Run Text="{Binding SubtotalBruto, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold"/>
                                                                <Run Text=" | Teto: "/><Run Text="{Binding PerDescMaxFormatado}" FontWeight="SemiBold" Foreground="{StaticResource BrushServsicBlue}"/>
                                                                <Run Text=" ("/><Run Text="{Binding MaxDescontoValorFormatado}" FontWeight="SemiBold" Foreground="{StaticResource BrushServsicBlue}"/><Run Text=")"/>
                                                            </TextBlock>

                                                            <Grid ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="48"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="TxtModalDesconto" 
                                                                         BeforeTextChanging="DecimalOnly_BeforeTextChanging"
                                                                         KeyDown="ModalDesc_KeyDown"
                                                                         Height="34" FontSize="12.5"/>
                                                                <Button x:Name="BtnModalToggleTipo"
                                                                        Grid.Column="1"
                                                                        Content="%"
                                                                        Click="BtnModalToggleTipo_Click"
                                                                        Height="34" Width="48"
                                                                        FontWeight="Bold" FontSize="12"
                                                                        Background="{StaticResource BrushServsicBlueSoft}"
                                                                        Foreground="{StaticResource BrushServsicBlue}"
                                                                        BorderBrush="{StaticResource BrushServsicBlue}"
                                                                        BorderThickness="1"
                                                                        ToolTipService.ToolTip="Alternar entre % e R$"/>
                                                            </Grid>

                                                            <Button Content="Salvar Desconto" 
                                                                    Click="BtnSalvarDescontoItem_Click"
                                                                    Style="{StaticResource BtnPrimary}" 
                                                                    HorizontalAlignment="Stretch" Height="34" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>

                                            <!-- 6. Total -->
                                            <TextBlock Grid.Column="6" Text="{Binding Total, Converter={StaticResource CurrencyConverter}}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <!-- 7. Botão Remover -->
                                            <Button Grid.Column="7" 
                                                    Click="BtnRemoverItem_Click"
                                                    Background="Transparent" BorderThickness="0" Padding="0" Width="30" Height="30"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Remover Item">
                                                <ic:SymbolIcon Symbol="Delete" FontSize="16" Foreground="{StaticResource BrushDanger}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================== -->
            <!-- COLUNA DIREITA: TIPO DE PEDIDO, IDENTIFICAÇÃO E RESUMO FINANCEIRO -->
            <!-- ============================================================== -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0. Seletor Orçamento / Pré-Venda + Dados do Pedido -->
                    <RowDefinition Height="*"/>    <!-- 1. Resumo Financeiro Vertical Completo -->
                </Grid.RowDefinitions>

                <!-- Card Superior: Seletor Orçamento / Pré-Venda e Identificação do Pedido -->
                <Border Grid.Row="0" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel Spacing="8">
                        <!-- Seletor Segmentado Orçamento / Pré-Venda -->
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="3" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Orçamento -->
                                <Border Grid.Column="0" 
                                        Background="{Binding BrushOrcamentoBackground}"
                                        BorderBrush="{Binding BrushOrcamentoBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Button Command="{Binding SelecionarOrcamentoCommand}"
                                            IsTabStop="False"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Height="34"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Padding="0">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <ic:SymbolIcon Symbol="DocumentText" FontSize="15" Foreground="{Binding BrushOrcamentoForeground}"/>
                                            <TextBlock Text="Orçamento" FontWeight="Bold" FontSize="12.5" Foreground="{Binding BrushOrcamentoForeground}"/>
                                        </StackPanel>
                                    </Button>
                                </Border>

                                <!-- Pré-Venda -->
                                <Border Grid.Column="1" 
                                        Background="{Binding BrushVendaBackground}"
                                        BorderBrush="{Binding BrushVendaBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Button Command="{Binding SelecionarVendaCommand}"
                                            IsTabStop="False"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Height="34"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Padding="0">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <ic:SymbolIcon Symbol="Cart" FontSize="15" Foreground="{Binding BrushVendaForeground}"/>
                                            <TextBlock Text="Pré-Venda" FontWeight="Bold" FontSize="12.5" Foreground="{Binding BrushVendaForeground}"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Dados do Pedido / Orçamento (Nº e Emissão) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="DADOS DO DOCUMENTO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}" CharacterSpacing="60"/>
                                        <Border Background="{Binding BrushTipoBadgeBackground}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding TipoDocumentoDescricao}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Pedido.NumeroFormatado}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="EMISSÃO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}" CharacterSpacing="60" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding Pedido.DataFormatada}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Botões de Ação do Pedido: Novo Pedido e Observações (Lado a Lado) -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Command="{Binding NovoCommand}"
                                    Style="{StaticResource BtnSecondary}"
                                    Height="36"
                                    HorizontalAlignment="Stretch"
                                    Padding="0"
                                    ToolTipService.ToolTip="Iniciar Novo Pedido ou Orçamento (F2)">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <ic:SymbolIcon Symbol="Add" FontSize="15" Foreground="{StaticResource BrushServsicBlue}"/>
                                    <TextBlock Text="Novo Pedido (F2)" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Command="{Binding AbrirObservacoesCommand}"
                                    Style="{StaticResource BtnSecondary}"
                                    Height="36"
                                    HorizontalAlignment="Stretch"
                                    Padding="0"
                                    ToolTipService.ToolTip="Inserir ou editar observações do pedido">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <ic:SymbolIcon Symbol="Note" FontSize="15" Foreground="{StaticResource BrushServsicBlue}"/>
                                    <TextBlock Text="Observações" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Botão Consultar Pedidos em Destaque -->
                        <Button x:Name="BtnConsultarPedidos"
                                Click="BtnConsultarHistorico_Click"
                                BorderThickness="0"
                                Height="36"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"
                                Padding="0"
                                GotFocus="BtnConsultarPedidos_GotFocus"
                                LostFocus="BtnConsultarPedidos_LostFocus"
                                PointerEntered="BtnConsultarPedidos_PointerEntered"
                                PointerExited="BtnConsultarPedidos_PointerExited"
                                ToolTipService.ToolTip="Consultar Pedidos e Orçamentos Gravados">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="#0284C7"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0B192C"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#07111E"/>
                                <SolidColorBrush x:Key="ButtonBackgroundFocused" Color="#0B192C"/>
                                <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundFocused" Color="#FFFFFF"/>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ic:SymbolIcon Symbol="DocumentSearch" FontSize="16" Foreground="#FFFFFF"/>
                                <TextBlock Text="Consultar Pedidos" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card Principal: Resumo Financeiro -->
                <Border Grid.Row="1" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Cabeçalho -->
                            <RowDefinition Height="*"/>    <!-- Campos e Totais -->
                            <RowDefinition Height="Auto"/> <!-- Botão Gravar -->
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho do Resumo -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ic:SymbolIcon Symbol="Receipt" FontSize="18" Foreground="{StaticResource BrushServsicBlue}"/>
                                <TextBlock Text="Resumo Financeiro" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Detalhamento de Valores e Observações -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="Itens no Pedido:" Foreground="{StaticResource BrushTextSubtle}" FontSize="13"/>
                                    <TextBlock Text="{Binding Pedido.QtdItens}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"/>
                                </Grid>

                                <Grid>
                                    <TextBlock Text="Subtotal Bruto:" Foreground="{StaticResource BrushTextSubtle}" FontSize="13"/>
                                    <TextBlock Text="{Binding Pedido.Subtotal, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"/>
                                </Grid>

                                <!-- Desconto Geral com alternância % / R$ -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Desconto Geral (" Foreground="{StaticResource BrushTextSubtle}" FontSize="12.5"/>
                                        <TextBlock Text="{Binding TipoDescontoGeralSimbolo}" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}" FontSize="12.5"/>
                                        <TextBlock Text="):" Foreground="{StaticResource BrushTextSubtle}" FontSize="12.5"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding DescontoGeralInputTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BeforeTextChanging="DecimalOnly_BeforeTextChanging"
                                             Height="32"/>
                                    <Button Grid.Column="2"
                                            Command="{Binding AlternarTipoDescontoGeralCommand}"
                                            Content="{Binding TipoDescontoGeralSimbolo}"
                                            FontWeight="Bold" FontSize="11"
                                            Height="32" Width="38" Padding="0"
                                            Background="{StaticResource BrushServsicBlueSoft}"
                                            Foreground="{StaticResource BrushServsicBlue}"
                                            BorderBrush="{StaticResource BrushServsicBlue}"
                                            BorderThickness="1"
                                            ToolTipService.ToolTip="Alternar Desconto Geral entre % e R$"/>
                                </Grid>

                                <!-- Margem Disponível do Desconto Geral -->
                                <Border Visibility="{Binding HasMargemDescontoGeralVisivel, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                        Padding="8,5" Margin="0,2,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ic:SymbolIcon Symbol="Tag" FontSize="13" Foreground="{Binding BrushMargemDescontoGeral}"/>
                                        <TextBlock Text="{Binding TextoMargemDescontoGeralRestante}"
                                                   FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{Binding BrushMargemDescontoGeral}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Acréscimo / Frete com alternância % / R$ -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Acrésc./Frete (" Foreground="{StaticResource BrushTextSubtle}" FontSize="12.5"/>
                                        <TextBlock Text="{Binding TipoAcrescimoGeralSimbolo}" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}" FontSize="12.5"/>
                                        <TextBlock Text="):" Foreground="{StaticResource BrushTextSubtle}" FontSize="12.5"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding AcrescimoGeralInputTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BeforeTextChanging="DecimalOnly_BeforeTextChanging"
                                             Height="32"/>
                                    <Button Grid.Column="2"
                                            Command="{Binding AlternarTipoAcrescimoGeralCommand}"
                                            Content="{Binding TipoAcrescimoGeralSimbolo}"
                                            FontWeight="Bold" FontSize="11"
                                            Height="32" Width="38" Padding="0"
                                            Background="{StaticResource BrushServsicBlueSoft}"
                                            Foreground="{StaticResource BrushServsicBlue}"
                                            BorderBrush="{StaticResource BrushServsicBlue}"
                                            BorderThickness="1"
                                            ToolTipService.ToolTip="Alternar Acréscimo entre % e R$"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,4"/>

                                <!-- Total Geral em Destaque -->
                                <Border Background="{StaticResource BrushServsicDark}" CornerRadius="8" Padding="16" Margin="0,10,0,0">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="VALOR TOTAL" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" CharacterSpacing="80"/>
                                        <TextBlock Text="{Binding Pedido.Total, Converter={StaticResource CurrencyConverter}}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlueLight}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Botão Totalizar (F6) -> Habilitado somente quando houver itens e verde ao focar -->
                        <Button x:Name="BtnTotalizar"
                                Grid.Row="2"
                                Command="{Binding SalvarCommand}"
                                IsEnabled="{Binding HasItens}"
                                Style="{StaticResource BtnPrimary}"
                                Height="48"
                                FontSize="15"
                                FontWeight="Bold"
                                GotFocus="BtnTotalizar_GotFocus"
                                LostFocus="BtnTotalizar_LostFocus"
                                PointerEntered="BtnTotalizar_PointerEntered"
                                PointerExited="BtnTotalizar_PointerExited">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="#0284C7"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#16A34A"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#15803D"/>
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E2E8F0"/>
                                <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#94A3B8"/>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="Wallet" FontSize="18"/>
                                <TextBlock Text="{Binding TextoBotaoSalvar}"/>
                            </StackPanel>
                        </Button>

                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- NOVO SISTEMA DE NOTIFICAÇÃO FLUTUANTE (TOP TOAST ELEVADO)     -->
        <!-- ============================================================== -->
        <Border Canvas.ZIndex="9999"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                MaxWidth="650"
                MinWidth="380"
                CornerRadius="8"
                BorderThickness="1.5"
                BorderBrush="{Binding IsSucesso, Converter={StaticResource NotificationBorderConverter}}"
                Background="{Binding IsSucesso, Converter={StaticResource NotificationBackgroundConverter}}"
                Visibility="{Binding StatusMensagem, Converter={StaticResource StringToVisibilityConverter}}"
                Padding="16,11">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ic:SymbolIcon Grid.Column="0" 
                               Symbol="Info" 
                               FontSize="18" 
                               Foreground="#FFFFFF" 
                               VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" 
                           Text="{Binding StatusMensagem}" 
                           Foreground="#FFFFFF" 
                           FontWeight="SemiBold" 
                           FontSize="13" 
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2" 
                        Command="{Binding FecharMensagemCommand}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="6,4" 
                        CornerRadius="4"
                        VerticalAlignment="Center" 
                        ToolTipService.ToolTip="Fechar notificação">
                    <ic:SymbolIcon Symbol="Dismiss" FontSize="14" Foreground="#FFFFFF"/>
                </Button>
            </Grid>
        </Border>



        <!-- ============================================================== -->
        <!-- MODAL 2: CADASTRO RÁPIDO DE CLIENTE COM OPÇÃO DE PESSOA & CNPJ  -->
        <!-- ============================================================== -->
        <Grid x:Name="ModalCadastroRapidoOverlay"
              Background="#750B192C" 
              KeyDown="ModalCadastroRapido_KeyDown"
              Visibility="{Binding IsCadastroRapidoClienteOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Padding="24">

            <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12"
                    MaxWidth="780" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Cabeçalho -->
                        <RowDefinition Height="Auto"/> <!-- Seletor Tipo Pessoa -->
                        <RowDefinition Height="*"/>    <!-- Formulário -->
                        <RowDefinition Height="Auto"/> <!-- Mensagem Status -->
                        <RowDefinition Height="Auto"/> <!-- Botões -->
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <ic:SymbolIcon Symbol="PersonAdd" FontSize="22" Foreground="{StaticResource BrushServsicBlue}"/>
                            <TextBlock Text="Cadastro Rápido de Cliente" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding FecharCadastroRapidoClienteCommand}" Background="Transparent" BorderThickness="0" Padding="6">
                            <ic:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource BrushTextSubtle}"/>
                        </Button>
                    </Grid>

                    <!-- Seletor de Tipo de Pessoa (Física x Jurídica) -->
                    <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="8" Padding="4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <!-- Pessoa Física -->
                            <Button Command="{Binding SelecionarPessoaFisicaCommand}"
                                    BorderThickness="0" CornerRadius="6" Height="34" Padding="16,0"
                                    Background="{Binding IsPessoaFisica, Converter={StaticResource StatusColorConverter}}"
                                    Foreground="#FFFFFF">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Person" FontSize="15"/>
                                    <TextBlock Text="Pessoa Física (CPF)" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Pessoa Jurídica -->
                            <Button Command="{Binding SelecionarPessoaJuridicaCommand}"
                                    BorderThickness="0" CornerRadius="6" Height="34" Padding="16,0"
                                    Background="{Binding IsPessoaJuridica, Converter={StaticResource StatusColorConverter}}"
                                    Foreground="#FFFFFF">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Building" FontSize="15"/>
                                    <TextBlock Text="Pessoa Jurídica (CNPJ)" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Formulário de Cadastro Rápido -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">

                            <!-- Linha do Documento (CPF / CNPJ + Botão de Consulta Online quando CNPJ) -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding LabelDocumento}" Style="{StaticResource TextLabel}"/>
                                    <TextBox x:Name="TxtNovoClienteDocumento"
                                             Text="{Binding NovoClienteDocumento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="NovoClienteCnpj_KeyDown"
                                             BeforeTextChanging="MascaraNumerica_BeforeTextChanging"
                                             TextChanging="Documento_TextChanging"
                                             PlaceholderText="{Binding PlaceholderDocumento}"
                                             MaxLength="18"
                                             Height="36"/>
                                </StackPanel>

                                <!-- Botão de Consulta de CNPJ na Web (Visível apenas quando Jurídica) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom"
                                            Visibility="{Binding IsPessoaJuridica, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Command="{Binding ConsultarCnpjCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="14,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ProgressRing IsActive="{Binding IsConsultandoCnpj}" Width="16" Height="16" Foreground="#FFFFFF"
                                                          Visibility="{Binding IsConsultandoCnpj, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <ic:SymbolIcon Symbol="Globe" FontSize="16"
                                                          Visibility="{Binding IsConsultandoCnpj, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            <TextBlock Text="Buscar Dados CNPJ na Receita" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Linha: Razão Social / Nome e Fantasia -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Nome / Razão Social *" Style="{StaticResource TextLabel}"/>
                                    <TextBox Text="{Binding NovoClienteNome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Ex: João da Silva / Empresa Ltda"
                                             Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Nome Fantasia / Apelido" Style="{StaticResource TextLabel}"/>
                                    <TextBox Text="{Binding NovoClienteFantasia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Ex: Loja Central"
                                             Height="36"/>
                                </StackPanel>
                            </Grid>

                            <!-- Linha: Contatos (Telefone Fixo e Celular/WhatsApp) -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Telefone Fixo" Style="{StaticResource TextLabel}"/>
                                    <TextBox x:Name="TxtNovoClienteTelefone"
                                             Text="{Binding NovoClienteTelefone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BeforeTextChanging="MascaraNumerica_BeforeTextChanging"
                                             TextChanging="Telefone_TextChanging"
                                             PlaceholderText="(00) 0000-0000"
                                             MaxLength="15"
                                             Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Celular / WhatsApp" Style="{StaticResource TextLabel}"/>
                                    <TextBox x:Name="TxtNovoClienteCelular"
                                             Text="{Binding NovoClienteCelular, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BeforeTextChanging="MascaraNumerica_BeforeTextChanging"
                                             TextChanging="Celular_TextChanging"
                                             PlaceholderText="(00) 00000-0000"
                                             MaxLength="15"
                                             Height="36"/>
                                </StackPanel>
                            </Grid>

                            <!-- Linha: E-mail (Linha própria abaixo dos telefones de contato) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="E-mail" Style="{StaticResource TextLabel}"/>
                                <TextBox x:Name="TxtNovoClienteEmail"
                                         Text="{Binding NovoClienteEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="contato@empresa.com"
                                         Height="36"/>
                            </StackPanel>

                            <!-- Linha: CEP, Endereço e Número -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="CEP" Style="{StaticResource TextLabel}"/>
                                    <TextBox x:Name="TxtNovoClienteCep"
                                             Text="{Binding NovoClienteCEP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BeforeTextChanging="MascaraNumerica_BeforeTextChanging"
                                             TextChanging="Cep_TextChanging"
                                             PlaceholderText="00000-000"
                                             MaxLength="9"
                                             Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Endereço (Rua, Av.)" Style="{StaticResource TextLabel}"/>
                                    <TextBox Text="{Binding NovoClienteEndereco, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Rua Principal..."
                                             Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Número" Style="{StaticResource TextLabel}"/>
                                    <TextBox Text="{Binding NovoClienteNumero, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="123"
                                             Height="36"/>
                                </StackPanel>
                            </Grid>

                            <!-- Linha: Bairro, Cidade e UF -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Bairro" Style="{StaticResource TextLabel}"/>
                                    <TextBox Text="{Binding NovoClienteBairro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Centro"
                                             Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Cidade" Style="{StaticResource TextLabel}"/>
                                    <TextBox Text="{Binding NovoClienteCidade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Cidade"
                                             Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="UF" Style="{StaticResource TextLabel}"/>
                                    <TextBox x:Name="TxtNovoClienteUf"
                                             Text="{Binding NovoClienteUF, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BeforeTextChanging="Uf_BeforeTextChanging"
                                             TextChanging="Uf_TextChanging"
                                             PlaceholderText="SP"
                                             MaxLength="2"
                                             Height="36"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Mensagem Normal de Retorno -->
                    <Border Grid.Row="3" CornerRadius="6" Padding="12,8" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1"
                            Visibility="{Binding IsCadastroDuplicadoBloqueado, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding CadastroRapidoMensagem}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"
                                   Visibility="{Binding CadastroRapidoMensagem, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </Border>

                    <!-- Mensagem de Alerta: Bloqueio por Duplicidade com Ação Imediata -->
                    <Border Grid.Row="3" CornerRadius="6" Padding="12,8" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            Visibility="{Binding IsCadastroDuplicadoBloqueado, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ic:SymbolIcon Symbol="DismissCircle" FontSize="18" Foreground="{StaticResource BrushDanger}"/>
                                <TextBlock Text="{Binding CadastroRapidoMensagem}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding UsarClienteDuplicadoExistenteCommand}" Style="{StaticResource BtnPrimary}" Height="30" Padding="12,0" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Checkmark" FontSize="14"/>
                                    <TextBlock Text="Usar Cliente Existente" FontSize="11.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Botões de Ação do Modal -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding FecharCadastroRapidoClienteCommand}" Style="{StaticResource BtnSecondary}" Height="38" Padding="18,0">
                                <TextBlock Text="Cancelar" FontWeight="SemiBold"/>
                            </Button>
                            <Button Command="{Binding SalvarCadastroRapidoClienteCommand}" Style="{StaticResource BtnPrimary}" Height="38" Padding="20,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Save" FontSize="16"/>
                                    <TextBlock Text="Salvar e Selecionar" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- MODAL: CONFIRMAÇÃO DE ALTERAÇÃO DE TIPO (ORÇAMENTO / PRÉ-VENDA)-->
        <!-- ============================================================== -->
        <Grid x:Name="ModalConfirmarTipoOverlay"
              Grid.RowSpan="2"
              Background="#750B192C"
              Visibility="{Binding IsConfirmarAlteracaoTipoOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              KeyDown="ModalConfirmarTipo_KeyDown"
              Padding="24">
            <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12"
                    MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Background="#E0F2FE" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="QuestionCircle" FontSize="24" Foreground="{StaticResource BrushServsicBlue}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Confirmar Alteração" FontSize="16" FontFamily="Segoe UI Semibold" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                            <TextBlock Text="Mudança no tipo do documento" FontSize="12.5" FontFamily="Segoe UI" Foreground="{StaticResource BrushTextSubtle}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding MensagemConfirmacaoTipo}" FontSize="14" FontFamily="Segoe UI" Foreground="{StaticResource BrushTextDark}" TextWrapping="Wrap"/>

                    <Grid ColumnSpacing="12" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnCancelarTipo" 
                                Grid.Column="0" 
                                Command="{Binding CancelarAlteracaoTipoCommand}" 
                                Click="BtnCancelarTipo_Click"
                                Style="{StaticResource BtnSecondary}" 
                                Height="38" 
                                HorizontalAlignment="Stretch">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" Invoked="BtnCancelarTipo_Invoked"/>
                            </Button.KeyboardAccelerators>
                            <TextBlock Text="Cancelar (Esc)" FontFamily="Segoe UI Semibold" FontWeight="SemiBold"/>
                        </Button>
                        <Button x:Name="BtnConfirmarTipo" 
                                Grid.Column="1" 
                                Command="{Binding ConfirmarAlteracaoTipoCommand}" 
                                Click="BtnConfirmarTipo_Click"
                                Style="{StaticResource BtnPrimary}" 
                                Height="38" 
                                HorizontalAlignment="Stretch">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" Invoked="BtnConfirmarTipo_Invoked"/>
                            </Button.KeyboardAccelerators>
                            <TextBlock Text="Sim, Alterar (Enter)" FontFamily="Segoe UI Semibold" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- MODAL: OBSERVAÇÕES DO PEDIDO                                   -->
        <!-- ============================================================== -->
        <Grid x:Name="ModalObservacoesOverlay"
              Grid.RowSpan="2"
              Background="#750B192C"
              Visibility="{Binding IsObservacoesOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              KeyDown="ModalObservacoes_KeyDown"
              Padding="24">
            <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12"
                    Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{StaticResource BrushServsicBlueSoft}" CornerRadius="6" Padding="8">
                                <ic:SymbolIcon Symbol="Note" FontSize="20" Foreground="{StaticResource BrushServsicBlue}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Observações do Pedido" FontSize="16" FontFamily="Segoe UI Semibold" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                <TextBlock Text="Instruções de entrega, condições comerciais ou notas" FontSize="11.5" Foreground="{StaticResource BrushTextSubtle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding FecharObservacoesCommand}" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="6">
                            <ic:SymbolIcon Symbol="Dismiss" Foreground="#94A3B8" FontSize="16"/>
                        </Button>
                    </Grid>

                    <TextBox x:Name="TxtModalObservacoes"
                             Text="{Binding Pedido.Obs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="140"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             PlaceholderText="Digite aqui observações e instruções deste pedido/orçamento..."
                             CornerRadius="6"
                             FontSize="13"/>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding FecharObservacoesCommand}" Style="{StaticResource BtnSecondary}" Height="38" HorizontalAlignment="Stretch">
                            <TextBlock Text="Cancelar (Esc)" FontFamily="Segoe UI Semibold" FontWeight="SemiBold"/>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding FecharObservacoesCommand}" Style="{StaticResource BtnPrimary}" Height="38" HorizontalAlignment="Stretch">
                            <TextBlock Text="Confirmar (Enter)" FontFamily="Segoe UI Semibold" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- COMPONENTE INDEPENDENTE: CHECKOUT MODAL DE CONDIÇÕES DE PAGAMENTO-->
        <!-- ============================================================== -->
        <views:CheckoutView x:Name="CheckoutModal"
                            Grid.RowSpan="2"
                            DataContext="{Binding CheckoutViewModel}"
                            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}" />

    </Grid>
</UserControl>
