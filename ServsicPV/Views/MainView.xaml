<Window
    x:Class="ServsicPV.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    Title="ServsicPV - Pedido de Venda e Orçamento">

    <Grid x:Name="RootGrid" Background="{StaticResource BrushIceBackground}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F3" Invoked="OnF3GlobalInvoked"/>
            <KeyboardAccelerator Key="F4" Invoked="OnF4GlobalInvoked"/>
            <KeyboardAccelerator Key="F2" Invoked="OnF2GlobalInvoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/> <!-- Barra de Título / Menu Superior Otimizado -->
            <RowDefinition Height="*"/>  <!-- Área de Trabalho Dinâmica -->
        </Grid.RowDefinitions>

        <!-- Barra Superior Corporativa -->
        <Border Grid.Row="0" Background="{StaticResource BrushServsicDark}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Lado Esquerdo: Seletor Segmentado Orçamento / Venda e Identificador do Pedido -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
                    <!-- Seletor Segmentado no Topo -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="3" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Button Command="{Binding SelecionarOrcamentoCommand}"
                                    Background="{Binding BrushOrcamentoBackground}"
                                    Foreground="{Binding BrushOrcamentoForeground}"
                                    FontWeight="Bold"
                                    FontSize="13"
                                    Height="32"
                                    CornerRadius="6"
                                    BorderThickness="0"
                                    Padding="14,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="DocumentText" FontSize="16"/>
                                    <TextBlock Text="Orçamento"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding SelecionarVendaCommand}"
                                    Background="{Binding BrushVendaBackground}"
                                    Foreground="{Binding BrushVendaForeground}"
                                    FontWeight="Bold"
                                    FontSize="13"
                                    Height="32"
                                    CornerRadius="6"
                                    BorderThickness="0"
                                    Padding="14,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Cart" FontSize="16"/>
                                    <TextBlock Text="Pedido de Venda"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Identificador do Pedido / Orçamento -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="DocumentBulletList" FontSize="15" Foreground="{StaticResource BrushServsicBlueLight}"/>
                            <TextBlock Text="{Binding Pedido.NumeroFormatado}" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlueLight}" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Lado Direito: Vendedor Responsável, Usuário Conectado & Logout -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                    <!-- Badge do Vendedor Vinculado ao Usuário -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Person" FontSize="16" Foreground="{StaticResource BrushServsicBlueLight}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="VENDEDOR" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" CharacterSpacing="50"/>
                                <TextBlock x:Name="TxtVendedorNome" Text="Vendedor" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Dados do Operador Logado -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtUsuarioNome" Text="Operador" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtUsuarioNivel" Text="Operador" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <Button Click="BtnSair_Click" Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="6" ToolTipService.ToolTip="Encerrar Sessão">
                        <ic:SymbolIcon Symbol="SignOut" FontSize="20" Foreground="#CBD5E1"/>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Área de Conteúdo -->
        <ContentControl x:Name="ContentArea" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

    </Grid>
</Window>
