<Window
    x:Class="ServsicPV.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:views="using:ServsicPV.Views"
    mc:Ignorable="d"
    Title="ServsicPV - Pedido de Venda e Orçamento">

    <Grid x:Name="RootGrid" Background="{StaticResource BrushIceBackground}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F2" Invoked="OnF7GlobalInvoked"/>
            <KeyboardAccelerator Key="F3" Invoked="OnF3GlobalInvoked"/>
            <KeyboardAccelerator Key="F4" Invoked="OnF4GlobalInvoked"/>
            <KeyboardAccelerator Key="F5" Invoked="OnF5GlobalInvoked"/>
            <KeyboardAccelerator Key="F6" Invoked="OnF6GlobalInvoked"/>
            <KeyboardAccelerator Key="F7" Invoked="OnF7GlobalInvoked"/>
            <KeyboardAccelerator Key="F8" Invoked="OnF8GlobalInvoked"/>
            <KeyboardAccelerator Key="F9" Invoked="OnF9GlobalInvoked"/>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnCtrlFGlobalInvoked"/>
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnCtrlEGlobalInvoked"/>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeGlobalInvoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/> <!-- Barra de Título / Menu Superior Otimizado -->
            <RowDefinition Height="*"/>  <!-- Área de Trabalho Dinâmica -->
        </Grid.RowDefinitions>

        <!-- Barra Superior Corporativa -->
        <Border Grid.Row="0" Background="{StaticResource BrushServsicDark}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Lado Esquerdo: Logo e Marca Compu + serve (em vermelho) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Image Source="ms-appx:///Assets/logo.png" Height="30" Width="30" Stretch="Uniform" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Compu" FontSize="20" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="serve" FontSize="20" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Lado Direito: Vendedor Responsável, Usuário Conectado & Logout -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                    <!-- Botão Central de Liberações (Supervisor / Gerente - Nivel >= 1) -->
                    <Button x:Name="BtnSupervisor" Click="BtnSupervisor_Click"
                            IsTabStop="False" CornerRadius="8" Padding="12,5"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Central de Liberações de Supervisor">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#1E293B"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0B192C"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#07111E"/>
                            <SolidColorBrush x:Key="ButtonBackgroundFocused" Color="#0B192C"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="ShieldCheckmark" FontSize="18" Foreground="#38BDF8"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SUPERVISOR" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" CharacterSpacing="50"/>
                                <TextBlock x:Name="TxtSupervisorLabel" Text="Liberações" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <Border x:Name="BadgeContadorLiberacoes" Background="#EF4444" CornerRadius="10" Padding="7,1" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="TxtContadorLiberacoes" Text="0" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Botão Meu Painel de Desempenho (Temporariamente oculto - código preservado para uso futuro)
                    <Button x:Name="BtnDesempenho" Click="BtnDesempenho_Click"
                            IsTabStop="False" CornerRadius="8" Padding="12,5"
                            ToolTipService.ToolTip="Meu Painel de Desempenho (Últimos 7 dias)">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#1E293B"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0B192C"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#07111E"/>
                            <SolidColorBrush x:Key="ButtonBackgroundFocused" Color="#0B192C"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="DataTrending" FontSize="18" Foreground="#38BDF8"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MEU PAINEL" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" CharacterSpacing="50"/>
                                <TextBlock Text="Desempenho" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    -->

                    <!-- Badge do Vendedor Vinculado ao Usuário -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Person" FontSize="16" Foreground="{StaticResource BrushServsicBlueLight}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="VENDEDOR" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" CharacterSpacing="50"/>
                                <TextBlock x:Name="TxtVendedorNome" Text="Vendedor" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Dados do Operador Logado -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtUsuarioNome" Text="Operador" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtUsuarioNivel" Text="Operador" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Botão de Atualizações do Sistema -->
                    <Button x:Name="BtnAtualizacoes" Click="BtnAtualizacoes_Click" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="6" ToolTipService.ToolTip="Verificar Atualizações do Sistema">
                        <ic:SymbolIcon Symbol="ArrowSync" FontSize="19" Foreground="#CBD5E1"/>
                    </Button>

                    <!-- Botão de Configurações / Impressora (Engrenagem) -->
                    <Button x:Name="BtnConfiguracoes" Click="BtnConfiguracoes_Click" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="6" ToolTipService.ToolTip="Configurar Impressora Térmica">
                        <ic:SymbolIcon Symbol="Settings" FontSize="20" Foreground="#CBD5E1"/>
                    </Button>

                    <Button Click="BtnSair_Click" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="6" ToolTipService.ToolTip="Encerrar Sessão">
                        <ic:SymbolIcon Symbol="SignOut" FontSize="20" Foreground="#CBD5E1"/>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Área de Conteúdo -->
        <ContentControl x:Name="ContentArea" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <!-- ============================================================== -->
        <!-- MODAL DE CONFIGURAÇÃO DE IMPRESSORA TÉRMICA                    -->
        <!-- ============================================================== -->
        <views:ConfiguracaoImpressoraView 
            Grid.Row="0" Grid.RowSpan="2"
            DataContext="{Binding ConfiguracaoImpressoraViewModel}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ============================================================== -->
        <!-- MODAL DE PRÉ-VISUALIZAÇÃO DO CUPOM NÃO-FISCAL                  -->
        <!-- ============================================================== -->
        <views:CupomVisualizacaoView 
            Grid.Row="0" Grid.RowSpan="2"
            DataContext="{Binding CupomVisualizacaoViewModel}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ============================================================== -->
        <!-- MODAL DE ATUALIZAÇÃO AUTOMÁTICA                                -->
        <!-- ============================================================== -->
        <views:AtualizacaoModalView 
            Grid.Row="0" Grid.RowSpan="2"
            DataContext="{Binding AtualizacaoViewModel}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>

    </Grid>
</Window>
