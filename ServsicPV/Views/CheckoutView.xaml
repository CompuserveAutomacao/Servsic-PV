<UserControl
    x:Class="ServsicPV.Views.CheckoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    x:Name="ControlRoot"
    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}">

    <!-- Fundo de Dimming / Overlay Escurecido -->
    <Grid Background="#800B192C" 
          KeyDown="CheckoutView_KeyDown" 
          Padding="16"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}">

        <!-- Card Central Modal Proporção Kactosys (Exatamente 950x520, Coluna 340) -->
        <Border Background="#F8FAFC" 
                BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="1" 
                CornerRadius="10"
                Width="950" 
                Height="520" 
                MaxHeight="520" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0. Cabeçalho Navy -->
                    <RowDefinition Height="*"/>    <!-- 1. Corpo em 2 Colunas: Pagamentos x Formulário -->
                    <RowDefinition Height="Auto"/> <!-- 2. Rodapé de Totais e Ações -->
                </Grid.RowDefinitions>

                <!-- ============================================================== -->
                <!-- 0. CABEÇALHO CORPORATIVO                                       -->
                <!-- ============================================================== -->
                <Border Grid.Row="0" Background="{StaticResource BrushServsicDark}" CornerRadius="10,10,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ícone e Títulos -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="#1E293B" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center">
                                <ic:SymbolIcon Symbol="Payment" FontSize="17" Foreground="{StaticResource BrushServsicBlueLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding TituloModal, FallbackValue='FINALIZAR — CHECKOUT DE PAGAMENTO'}" 
                                           FontSize="13" 
                                           FontFamily="Segoe UI Semibold" 
                                           FontWeight="Bold" 
                                           Foreground="#FFFFFF" 
                                           CharacterSpacing="25"/>
                                <TextBlock Text="{Binding SubtituloModal, FallbackValue='Definição do Plano de Contas'}" 
                                           FontSize="10.5" 
                                           FontFamily="Segoe UI" 
                                           Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Identificação do Cliente -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6" Margin="0,0,14,0">
                            <TextBlock Text="Cliente:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ClienteExibicao, FallbackValue='Consumidor / Balcão'}" 
                                       FontSize="11.5" 
                                       FontWeight="SemiBold" 
                                       Foreground="#FFFFFF" 
                                       VerticalAlignment="Center" 
                                       MaxWidth="260" 
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Botão Fechar (X) -->
                        <Button Grid.Column="2" 
                                x:Name="BtnFechar"
                                Command="{Binding CancelarCheckoutCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="4" 
                                CornerRadius="4">
                            <ic:SymbolIcon Symbol="Dismiss" FontSize="15" Foreground="#CBD5E1"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ============================================================== -->
                <!-- 1. CORPO PRINCIPAL EM 2 COLUNAS                                -->
                <!-- ============================================================== -->
                <Grid Grid.Row="1" ColumnSpacing="14" Padding="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUNA ESQUERDA: Pagamentos Vinculados -->
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Título da Seção -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                <ic:SymbolIcon Symbol="Payment" Foreground="{StaticResource BrushServsicBlue}" FontSize="18"/>
                                <TextBlock Text="PAGAMENTOS VINCULADOS" FontSize="13" FontFamily="Segoe UI Semibold" FontWeight="Bold" Foreground="{StaticResource BrushServsicDark}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Empty State quando não há pagamentos -->
                            <StackPanel Grid.Row="1" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Center" 
                                        Spacing="10"
                                        Visibility="{Binding HasNoPagamentos, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ic:SymbolIcon Symbol="Receipt" FontSize="42" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                <TextBlock Text="Nenhum pagamento registrado ainda." FontSize="13.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock Text="Selecione a forma ao lado e confirme o valor." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Lista de Pagamentos Lançados -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasPagamentos, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListView ItemsSource="{Binding PagamentosLancados}" SelectionMode="None" Padding="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="10,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Descrição e Vencimento -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Recebimento}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource BrushTextDark}"/>
                                                    <TextBlock Text="{Binding VencimentoDescricao}" FontSize="11" Foreground="{StaticResource BrushTextSubtle}"/>
                                                </StackPanel>

                                                <!-- Valor -->
                                                <TextBlock Grid.Column="1" Text="{Binding ValorFormatado}" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource BrushServsicDark}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0"/>

                                                <!-- Troco se houver -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Visibility="{Binding TrocoVisivel, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Troco: " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TrocoFormatado}" FontWeight="SemiBold" FontSize="13" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Botão Remover -->
                                                <Button Grid.Column="3" 
                                                        Command="{Binding ElementName=ControlRoot, Path=DataContext.RemoverPagamentoCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        Width="32" Height="32"
                                                        CornerRadius="16"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                    <ic:SymbolIcon Symbol="Delete" FontSize="15" Foreground="{StaticResource BrushDanger}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- COLUNA DIREITA: Registro de Pagamento (Formulário Kactosys) -->
                    <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <!-- Título do Formulário -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2">
                                    <ic:SymbolIcon Symbol="Money" Foreground="{StaticResource BrushServsicBlue}" FontSize="18"/>
                                    <TextBlock Text="REGISTRAR PAGAMENTO" FontSize="13" FontFamily="Segoe UI Semibold" FontWeight="Bold" Foreground="{StaticResource BrushServsicDark}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 🟢 Banner de Totalmente Quitado (Quando SaldoRestante == 0) -->
                                <Border Background="#F0FDF4" 
                                        BorderBrush="#BBF7D0" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="14,12"
                                        Visibility="{Binding IsQuitado, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <ic:SymbolIcon Symbol="CheckmarkCircle" Foreground="{StaticResource BrushServsicBlue}" FontSize="18"/>
                                            <TextBlock Text="TOTALMENTE QUITADO" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource BrushServsicDark}"/>
                                        </StackPanel>
                                        <TextBlock Text="O pedido já está 100% quitado. Para finalizar a venda, pressione Concluir (F6)." 
                                                   FontSize="11.5" 
                                                   Foreground="#047857" 
                                                   TextAlignment="Center" 
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Controles de Inserção de Pagamento (Bloqueados quando quitado) -->
                                <ContentControl IsEnabled="{Binding IsPagamentoHabilitado}" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="14">
                                    <!-- Seleção da Forma de Pagamento -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Forma de Pagamento (↑/↓ Navega, Enter Seleciona)" Style="{StaticResource TextLabel}"/>
                                        <ComboBox x:Name="CmbFormaPagamento"
                                                  ItemsSource="{Binding FormasDisponiveis}"
                                                  SelectedItem="{Binding FormaSelecionada, Mode=TwoWay}"
                                                  PreviewKeyDown="CmbFormaPagamento_PreviewKeyDown"
                                                  KeyDown="CmbFormaPagamento_KeyDown"
                                                  HorizontalAlignment="Stretch"
                                                  Height="38"
                                                  CornerRadius="6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DescricaoFormatada}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Campo Valor Recebido -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Valor Recebido (R$)" Style="{StaticResource TextLabel}"/>
                                        <TextBox x:Name="TxtValor"
                                                 Text="{Binding ValorInputTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 BeforeTextChanging="DecimalOnly_BeforeTextChanging"
                                                 KeyDown="TxtValor_KeyDown"
                                                 LostFocus="TxtValor_LostFocus"
                                                 Height="44"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Foreground="{StaticResource BrushServsicDark}"
                                                 PlaceholderText="0,00"
                                                 CornerRadius="6"/>
                                    </StackPanel>

                                    <!-- ⚠️ Aviso: Pagamento a Prazo sem Cliente identificado -->
                                    <Border Background="#FFFBEB"
                                            BorderBrush="#FDE68A"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Visibility="{Binding IsFormaAPrazoSemCliente, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ic:SymbolIcon Symbol="Warning" Foreground="#D97706" FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="Cliente não identificado" FontWeight="Bold" FontSize="12" Foreground="#92400E" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Esta forma de pagamento é a prazo e requer um cliente vinculado no pedido."
                                                       FontSize="11" Foreground="#78350F" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Painel de Parcelas (visível se GeraConta / a prazo) -->
                                    <StackPanel Spacing="10" Visibility="{Binding FormaSelecionadaGeraConta, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Parcelas" Style="{StaticResource TextLabel}"/>
                                                <TextBox x:Name="TxtParcelas"
                                                         Text="{Binding NumeroParcelas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         BeforeTextChanging="IntegerOnly_BeforeTextChanging"
                                                         KeyDown="TxtParcelas_KeyDown"
                                                         Height="38"
                                                         FontSize="14"
                                                         PlaceholderText="1"
                                                         CornerRadius="6"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Dias p/ Parcela" Style="{StaticResource TextLabel}"/>
                                                <TextBox Text="{Binding IntervaloDias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         BeforeTextChanging="IntegerOnly_BeforeTextChanging"
                                                         Height="38"
                                                         FontSize="14"
                                                         PlaceholderText="30"
                                                         CornerRadius="6"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Prévia das Parcelas Calculadas -->
                                        <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="PREVISÃO DAS PARCELAS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}" Margin="0,0,0,2"/>
                                                <ListView ItemsSource="{Binding PreviaParcelas}" SelectionMode="None" MaxHeight="90" Padding="0">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding NumeroEVencimento}" FontSize="11" Foreground="{StaticResource BrushTextDark}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ValorFormatado}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushServsicDark}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Botão Confirmar Valor (Enter) -->
                                    <Button Command="{Binding AdicionarPagamentoCommand}"
                                            Style="{StaticResource BtnPrimary}"
                                            Height="38"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <ic:SymbolIcon Symbol="Add" FontSize="15"/>
                                            <TextBlock Text="Confirmar Valor (Enter)" FontFamily="Segoe UI Semibold" FontWeight="Bold" FontSize="12.5"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ContentControl>

                                <!-- Caixa de Troco Dinâmica (Vermelho suave Kactosys) -->
                                <Border Background="#FEF2F2" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        BorderBrush="#FECACA" 
                                        BorderThickness="1"
                                        Visibility="{Binding TrocoVisivel, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="TROCO DO CLIENTE" FontSize="10" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TrocoFormatado}" FontSize="26" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Mensagem de Aviso / Alerta -->
                                <TextBlock Text="{Binding Mensagem}" 
                                           FontSize="11.5" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushDanger}" 
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Mensagem, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ============================================================== -->
                <!-- 2. RODAPÉ DE TOTAIS E BOTÕES DE AÇÃO (ESTILO KACTOSYS)         -->
                <!-- ============================================================== -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,10" CornerRadius="0,0,10,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Totais Financeiros no Rodapé -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                            <StackPanel Spacing="1">
                                <TextBlock Text="TOTAL A PAGAR" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8" CharacterSpacing="40"/>
                                <TextBlock Text="{Binding TotalAProcessarFormatado}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushServsicDark}"/>
                            </StackPanel>

                            <Border Width="1" Height="26" Background="{StaticResource BrushBorder}"/>

                            <StackPanel Spacing="1">
                                <TextBlock Text="TOTAL PAGO" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8" CharacterSpacing="40"/>
                                <TextBlock Text="{Binding TotalPagoFormatado}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                            </StackPanel>

                            <Border Width="1" Height="26" Background="{StaticResource BrushBorder}"/>

                            <StackPanel Spacing="1">
                                <TextBlock Text="RESTANTE" FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8" CharacterSpacing="40"/>
                                <TextBlock Text="{Binding TotalRestanteFormatado}" FontSize="16" FontWeight="Bold" Foreground="{Binding RestanteBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Botões de Ação à Direita -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Command="{Binding CancelarCheckoutCommand}" 
                                    Style="{StaticResource BtnSecondary}" 
                                    Height="38" 
                                    Padding="14,0"
                                    MinWidth="100"
                                    CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="14"/>
                                    <TextBlock Text="Voltar (Esc)" FontFamily="Segoe UI Semibold" FontWeight="SemiBold" FontSize="12.5"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnFinalizar"
                                    Command="{Binding FinalizarCheckoutCommand}" 
                                    IsEnabled="{Binding IsQuitado}"
                                    KeyDown="BtnFinalizar_KeyDown"
                                    Style="{StaticResource BtnPrimary}" 
                                    Height="38" 
                                    Padding="18,0"
                                    MinWidth="150"
                                    CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <ic:SymbolIcon Symbol="Checkmark" FontSize="15"/>
                                    <TextBlock Text="{Binding TextoBotaoConfirmar, FallbackValue='Concluir (F6)'}" FontFamily="Segoe UI Semibold" FontWeight="Bold" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
