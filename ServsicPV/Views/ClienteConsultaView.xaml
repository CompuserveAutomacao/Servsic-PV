<UserControl
    x:Class="ServsicPV.Views.ClienteConsultaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BrushIceBackground}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra Superior de Filtros e Ações -->
            <RowDefinition Height="*"/>    <!-- Grade de Resultados em Tela Cheia -->
            <RowDefinition Height="Auto"/> <!-- Barra Inferior / Rodapé de Confirmação -->
        </Grid.RowDefinitions>

        <!-- 1. Barra Superior com Título, Pesquisa e Botões -->
        <Border Grid.Row="0" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,14">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título da Tela -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource BrushServsicBlueSoft}" VerticalAlignment="Center">
                        <ic:SymbolIcon Symbol="PeopleSearch" FontSize="20" Foreground="{StaticResource BrushServsicBlue}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Consulta de Clientes" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                        <TextBlock Text="Pesquisa em tela cheia com dados cadastrais e crédito a prazo" FontSize="11.5" Foreground="{StaticResource BrushTextSubtle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Campo de Pesquisa em Tempo Real -->
                <TextBox x:Name="TxtFiltro" Grid.Column="1"
                         Text="{Binding FiltroTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="TxtFiltro_KeyDown"
                         PlaceholderText="Buscar por Nome, Razão Social, Fantasia, CPF/CNPJ, Telefone ou Código..."
                         Height="40" VerticalAlignment="Center"/>

                <!-- Botão Novo Cliente -->
                <Button Grid.Column="2" Command="{Binding NovoClienteCommand}" Style="{StaticResource BtnSecondary}" Height="40" Padding="16,0" ToolTipService.ToolTip="Abrir Cadastro Rápido de Cliente">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Add" FontSize="16" Foreground="{StaticResource BrushServsicBlue}"/>
                        <TextBlock Text="Novo Cliente" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Botão Voltar ao Pedido -->
                <Button Grid.Column="3" Command="{Binding VoltarAoPedidoCommand}" Style="{StaticResource BtnSecondary}" Height="40" Padding="14,0" ToolTipService.ToolTip="Voltar ao Pedido (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="ArrowLeft" FontSize="16"/>
                        <TextBlock Text="Voltar (Esc)" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 2. Grade de Resultados Ocupando Todo o Espaço -->
        <Border Grid.Row="1" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <ProgressBar IsIndeterminate="True" 
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                             VerticalAlignment="Top" Margin="0,-12,0,0"/>

                <ListView x:Name="ListaClientes"
                          ItemsSource="{Binding Clientes}" 
                          SelectedItem="{Binding ClienteSelecionado, Mode=TwoWay}"
                          SingleSelectionFollowsFocus="True"
                          IsItemClickEnabled="True"
                          DoubleTapped="ListaClientes_DoubleTapped"
                          BorderThickness="0"
                          SelectionMode="Single">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Background="#F1F5F9" Padding="16,10" CornerRadius="6" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CÓDIGO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}"/>
                                <TextBlock Grid.Column="1" Text="NOME / RAZÃO SOCIAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}"/>
                                <TextBlock Grid.Column="2" Text="FANTASIA / APELIDO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}"/>
                                <TextBlock Grid.Column="3" Text="CPF / CNPJ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}"/>
                                <TextBlock Grid.Column="4" Text="TELEFONE / CELULAR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}"/>
                                <TextBlock Grid.Column="5" Text="CIDADE / UF" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}"/>
                                <TextBlock Grid.Column="6" Text="LIMITE A PRAZO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="7" Text="SITUAÇÃO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSubtle}" TextAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="16,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Controle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushServsicBlue}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Fantasia}" FontSize="12" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding DocumentoFormatado}" FontSize="12" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Telefone}" FontSize="12" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding CidadeUF}" FontSize="12" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                
                                <!-- Limite a Prazo -->
                                <StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LimiteFormatado}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}" HorizontalAlignment="Right"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Right"
                                               Visibility="{Binding HasTitulosVencidos, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Run Text="Venc: "/><Run Text="{Binding TotalVencidoFormatado}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Situação de Crédito a Prazo -->
                                <StackPanel Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Badge Desbloqueado -->
                                    <Border CornerRadius="4" Padding="8,3" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                                            Visibility="{Binding IsBloqueado, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="13" Foreground="{StaticResource BrushServsicBlue}"/>
                                            <TextBlock Text="LIBERADO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Badge Bloqueado -->
                                    <Border CornerRadius="4" Padding="8,3" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                            Visibility="{Binding IsBloqueado, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="{Binding StatusCreditoDescricao}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ic:SymbolIcon Symbol="LockClosed" FontSize="13" Foreground="{StaticResource BrushDanger}"/>
                                            <TextBlock Text="BLOQUEADO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushDanger}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Mensagem se nenhum item for encontrado -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            Visibility="{Binding Mensagem, Converter={StaticResource StringToVisibilityConverter}}">
                    <ic:SymbolIcon Symbol="PersonWarning" FontSize="36" Foreground="{StaticResource BrushTextSubtle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Mensagem}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSubtle}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Rodapé Operacional -->
        <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Enter: Selecionar Cliente" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSubtle}"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Esc: Voltar ao Pedido" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSubtle}"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Setas ↑/↓: Navegar na Grade" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSubtle}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="BtnCancelar" Command="{Binding VoltarAoPedidoCommand}" Style="{StaticResource BtnSecondary}" Height="38" Padding="20,0">
                        <TextBlock Text="Cancelar (Esc)" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="BtnSelecionar" Command="{Binding ConfirmarSelecaoCommand}" Style="{StaticResource BtnPrimary}" Height="38" Padding="24,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Checkmark" FontSize="16"/>
                            <TextBlock Text="Selecionar Cliente (Enter)" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
