<UserControl
    x:Class="ServsicPV.Views.ProdutoConsultaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BrushIceBackground}" Padding="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Cabeçalho Superior: Título & Botão no Topo -->
            <RowDefinition Height="Auto"/> <!-- 1. Barra de Pesquisa Dedicada -->
            <RowDefinition Height="*"/>    <!-- 2. Área Principal: Grade (Esquerda) + Card Detalhes (Direita) -->
            <RowDefinition Height="Auto"/> <!-- 3. Rodapé com Atalhos e Contagem -->
        </Grid.RowDefinitions>

        <!-- 0. Cabeçalho Superior da Tela: Título e Botão Livres no Topo -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Lado Esquerdo: Identidade da Tela com Ícone -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource BrushServsicBlueSoft}" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="BoxSearch" FontSize="22" Foreground="{StaticResource BrushServsicBlue}"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Consulta de Produtos" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                        <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="F4 - ITENS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Pesquisa inteligente por Descrição, Grupo, Marca/Fabricante, Código e Localização" FontSize="12" Foreground="{StaticResource BrushTextSubtle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Lado Direito: Botão Voltar ao Pedido -->
            <Button Grid.Column="1" Command="{Binding VoltarAoPedidoCommand}" Style="{StaticResource BtnSecondary}" Height="38" Padding="16,0" ToolTipService.ToolTip="Voltar ao Pedido de Venda (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:SymbolIcon Symbol="ArrowLeft" FontSize="16"/>
                    <TextBlock Text="Voltar (Esc)" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 1. Barra de Pesquisa Dedicada de Ponta a Ponta -->
        <Border Grid.Row="1" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ic:SymbolIcon Grid.Column="0" Symbol="Search" FontSize="18" Foreground="{StaticResource BrushServsicBlue}" VerticalAlignment="Center" Margin="6,0,2,0"/>
                <TextBox x:Name="TxtFiltro" Grid.Column="1"
                         Text="{Binding FiltroTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="TxtFiltro_KeyDown"
                         PlaceholderText="Digite qualquer termo (ex: cimento nassau, tubo tigre, ferragem 8mm, código ou localização)..."
                         Height="38" VerticalAlignment="Center"
                         BorderThickness="0" Background="Transparent"/>
            </Grid>
        </Border>

        <!-- 2. Área Principal: Grade de Produtos (Esquerda) + Card Lateral de Detalhes (Direita) -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>     <!-- Grade de Resultados -->
                <ColumnDefinition Width="380"/>   <!-- Card Lateral de Detalhes Completo -->
            </Grid.ColumnDefinitions>

            <!-- 2.1 Grade de Produtos em Tabela Limpa e Espaçosa -->
            <Border Grid.Column="0" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <ProgressBar IsIndeterminate="True" 
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                 VerticalAlignment="Top" Margin="0,-10,0,0"/>

                    <ListView x:Name="ListaProdutos"
                              ItemsSource="{Binding Produtos}"
                              SelectedItem="{Binding ProdutoSelecionado, Mode=TwoWay}"
                              SingleSelectionFollowsFocus="True"
                              IsItemClickEnabled="True"
                              DoubleTapped="ListaProdutos_DoubleTapped"
                              BorderThickness="0"
                              SelectionMode="Single">
                        <ListView.Resources>
                            <!-- Cores Nativas do Card e Estados de Foco/Seleção do WinUI 3 -->
                            <SolidColorBrush x:Key="ListViewItemBackground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ListViewItemBorderBrush" Color="#E2E8F0"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#F8FAFC"/>
                            <SolidColorBrush x:Key="ListViewItemBorderBrushPointerOver" Color="#0284C7"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#F0F9FF"/>
                            <SolidColorBrush x:Key="ListViewItemBorderBrushSelected" Color="#0284C7"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#E0F2FE"/>
                            <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPointerOver" Color="#0284C7"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#BAE6FD"/>
                            <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPressed" Color="#0369A1"/>
                            
                            <!-- Indicador Lateral Azul Corporativo (Selection Pill do WinUI) -->
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#0284C7"/>
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#0284C7"/>
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#0369A1"/>
                            
                            <!-- Elimina o retângulo preto de foco do Windows -->
                            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent"/>
                            <Thickness x:Key="ListViewItemBorderThickness">1</Thickness>
                            <Thickness x:Key="ListViewItemSelectedBorderThickness">2</Thickness>
                            <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="Margin" Value="0,3"/>
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                                <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
                                <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Badges Superiores e Preço -->
                                        <RowDefinition Height="Auto"/> <!-- Descrição Completa -->
                                        <RowDefinition Height="Auto"/> <!-- Metadados (Marca, Setor, Unidade) -->
                                    </Grid.RowDefinitions>

                                    <!-- Linha 1: Badges de Códigos à Esquerda + Badges Modernos de Estoque e Preço à Direita -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Badges de Identificação -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- Badge CÓD (Controle do Produto) -->
                                            <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="CÓD" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                                    <TextBlock Text="{Binding CodigoFormatado}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Badge EAN / Código de Barras Principal (CodInterno no banco de dados) -->
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                    Visibility="{Binding HasEan, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <ic:SymbolIcon Symbol="BarcodeScanner" FontSize="13" Foreground="{StaticResource BrushTextSubtle}"/>
                                                    <TextBlock Text="{Binding Ean}" FontSize="11" Foreground="{StaticResource BrushTextDark}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Badge Cód. Barras Adicional (se houver e for diferente) -->
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                    Visibility="{Binding HasCodBarraAdicional, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="ADIC:" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding CodBarraAdicional}" FontSize="11" Foreground="{StaticResource BrushTextDark}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Badge Cód. Origem / Atacado (se houver) -->
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                    Visibility="{Binding HasCodOrigem, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="ORIGEM:" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding CodOrigemFormatado}" FontSize="11" Foreground="{StaticResource BrushTextDark}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Badge Localização no Estoque (campo Moeda) -->
                                            <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                    Visibility="{Binding Localizacao, Converter={StaticResource StringToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <ic:SymbolIcon Symbol="Location" FontSize="11" Foreground="#B45309"/>
                                                    <TextBlock Text="{Binding Localizacao}" FontSize="11" FontWeight="SemiBold" Foreground="#92400E"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Destaque à Direita: Badges Modernos de Estoque e Preço -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <!-- Badge Estoque se DISPONÍVEL -->
                                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                                                    Visibility="{Binding HasEstoque, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="#059669" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding EstoqueFormatado}" FontSize="11.5" FontWeight="SemiBold" Foreground="#065F46" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Badge Estoque se SEM ESTOQUE -->
                                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                                                    Visibility="{Binding HasEstoque, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="#DC2626" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Sem Estoque" FontSize="11.5" FontWeight="SemiBold" Foreground="#991B1B" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Badge Preço de Venda Moderno -->
                                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10,3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="R$" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding PrVendaValorFormatado}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Linha 2: Descrição Completa do Produto -->
                                    <TextBlock Grid.Row="1" Text="{Binding Descricao}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}" TextWrapping="Wrap"/>

                                    <!-- Linha 3: Metadados (Marca/Fabricante, Grupo/Setor, Subgrupo, Unidade) -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                        <!-- Marca / Fabricante -->
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                                    Visibility="{Binding Fabricante, Converter={StaticResource StringToVisibilityConverter}}">
                                            <ic:SymbolIcon Symbol="Tag" FontSize="12" Foreground="{StaticResource BrushTextSubtle}"/>
                                            <TextBlock Text="{Binding Fabricante}" FontSize="11.5" Foreground="{StaticResource BrushTextSubtle}"/>
                                        </StackPanel>

                                        <!-- Grupo / Setor -->
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                                    Visibility="{Binding Grupo, Converter={StaticResource StringToVisibilityConverter}}">
                                            <ic:SymbolIcon Symbol="Folder" FontSize="12" Foreground="{StaticResource BrushTextSubtle}"/>
                                            <TextBlock Text="{Binding Grupo}" FontSize="11.5" Foreground="{StaticResource BrushTextSubtle}"/>
                                        </StackPanel>

                                        <!-- Subgrupo -->
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                                    Visibility="{Binding SubGrupo, Converter={StaticResource StringToVisibilityConverter}}">
                                            <ic:SymbolIcon Symbol="BranchFork" FontSize="12" Foreground="{StaticResource BrushTextSubtle}"/>
                                            <TextBlock Text="{Binding SubGrupo}" FontSize="11.5" Foreground="{StaticResource BrushTextSubtle}"/>
                                        </StackPanel>

                                        <!-- Unidade -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="UN:" FontSize="11" Foreground="{StaticResource BrushTextSubtle}"/>
                                            <TextBlock Text="{Binding Unidade}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSubtle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Mensagem quando vazio -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                Visibility="{Binding Mensagem, Converter={StaticResource StringToVisibilityConverter}}">
                        <ic:SymbolIcon Symbol="Search" FontSize="32" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Mensagem}" FontSize="13" Foreground="{StaticResource BrushTextSubtle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2.2 Card Lateral de Detalhes do Produto Selecionado -->
            <Border Grid.Column="1" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Cabeçalho do Card -->
                        <RowDefinition Height="*"/>    <!-- Conteúdo Scrollável: Imagem + Dados -->
                        <RowDefinition Height="Auto"/> <!-- Botão de Confirmação no Rodapé -->
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho do Card -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ic:SymbolIcon Symbol="DocumentLandscapeData" FontSize="18" Foreground="{StaticResource BrushServsicBlue}"/>
                        <TextBlock Text="Ficha Detalhada do Produto" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                    </StackPanel>

                    <!-- Detalhes do Produto -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Visibility="{Binding HasProdutoSelecionado, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!-- Visualizador da Imagem do Produto -->
                            <Border Height="180" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="4">
                                <Grid>
                                    <!-- Imagem Real Carregada do Banco -->
                                    <Image Source="{Binding FotoBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Placeholder quando sem imagem -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                                Visibility="{Binding FotoBitmap, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                        <ic:SymbolIcon Symbol="Image" FontSize="36" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sem imagem cadastrada" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Descrição Completa -->
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="12,10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="DESCRIÇÃO" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="50"/>
                                    <TextBlock Text="{Binding ProdutoSelecionado.Descricao}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Destaque: Preço de Venda e Estoque -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Preço de Venda -->
                                <Border Grid.Column="0" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="PREÇO DE VENDA" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}" CharacterSpacing="50"/>
                                        <TextBlock Text="{Binding ProdutoSelecionado.PrVendaFormatado}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Estoque Atual -->
                                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="ESTOQUE ATUAL" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="50"/>
                                        <TextBlock Text="{Binding ProdutoSelecionado.EstoqueFormatado}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- SEÇÃO DE CÓDIGOS DE IDENTIFICAÇÃO (ERP LEGADO & FISCAL) -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ic:SymbolIcon Symbol="BarcodeScanner" FontSize="14" Foreground="{StaticResource BrushServsicBlue}"/>
                                        <TextBlock Text="CÓDIGOS DE IDENTIFICAÇÃO" FontSize="10.5" FontWeight="Bold" Foreground="#475569" CharacterSpacing="50"/>
                                    </StackPanel>

                                    <!-- Linha 1: Controle (ID) e Código / Cód. Barras (EAN) -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Controle (ID) -->
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Controle (ID)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoSelecionado.ControleTexto}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Código / Cód. Barras (EAN) -->
                                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Código / Cód. Barras (EAN)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoSelecionado.EanFormatado}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Linha 2: Cód Atacado/Origem e Cód. Barras Adicional -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Cód. Atacado / Origem -->
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Cód. Atacado / Origem" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoSelecionado.CodOrigemFormatado}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Cód. Barras Adicional -->
                                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Cód. Barras Adicional" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoSelecionado.CodBarraAdicionalFormatado}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Linha 3: Cód. Caixa/Atacado e Cód. Fornecedor -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Cód. Caixa / Atacado -->
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Cód. Caixa / Atacado" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoSelecionado.CodBarraCxFormatado}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Cód. Fornecedor -->
                                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Cód. Fornecedor" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoSelecionado.CodFornecedorFormatado}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Linha 4: NCM e CEST (Fiscal) -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- NCM -->
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="NCM (Classificação Fiscal)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoSelecionado.NcmFormatado}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- CEST -->
                                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="CEST" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoSelecionado.CestFormatado}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Localização Física (Campo Moeda da TabEst1) -->
                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ic:SymbolIcon Grid.Column="0" Symbol="Location" FontSize="20" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="LOCALIZAÇÃO NO ESTOQUE (MOEDA)" FontSize="9.5" FontWeight="Bold" Foreground="#B45309" CharacterSpacing="50"/>
                                        <TextBlock Text="{Binding ProdutoSelecionado.LocalizacaoFormatada}" FontSize="13" FontWeight="Bold" Foreground="#78350F"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Apresentação / Embalagem -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="APRESENTAÇÃO / EMBALAGEM" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="50"/>
                                    <TextBlock Text="{Binding ProdutoSelecionado.ApresentacaoFormatada}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>
                            </Border>

                            <!-- Ficha Técnica e Metadados -->
                            <StackPanel Spacing="8">
                                <!-- Unidade de Medida -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Unidade de Medida" FontSize="11" Foreground="{StaticResource BrushTextSubtle}"/>
                                    <TextBlock Text="{Binding ProdutoSelecionado.Unidade}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>

                                <!-- Marca / Fabricante -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Marca / Fabricante" FontSize="11" Foreground="{StaticResource BrushTextSubtle}"/>
                                    <TextBlock Text="{Binding ProdutoSelecionado.FabricanteFormatado}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>

                                <!-- Grupo / Setor -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Grupo / Setor" FontSize="11" Foreground="{StaticResource BrushTextSubtle}"/>
                                    <TextBlock Text="{Binding ProdutoSelecionado.GrupoFormatado}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>

                                <!-- Subgrupo -->
                                <StackPanel Spacing="2" Visibility="{Binding ProdutoSelecionado.SubGrupo, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="Subgrupo" FontSize="11" Foreground="{StaticResource BrushTextSubtle}"/>
                                    <TextBlock Text="{Binding ProdutoSelecionado.SubGrupo}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>

                                <!-- Desconto Máximo Permitido -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Desconto Máximo Permitido" FontSize="11" Foreground="{StaticResource BrushTextSubtle}"/>
                                    <TextBlock Text="{Binding ProdutoSelecionado.PerDescMaxFormatado}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushServsicBlue}"/>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botão de Ação: Selecionar Produto -->
                    <Button Grid.Row="2" Command="{Binding ConfirmarSelecaoCommand}" Style="{StaticResource BtnPrimary}" Height="42" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Checkmark" FontSize="18"/>
                            <TextBlock Text="Inserir no Pedido (Enter)" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Rodapé com Atalhos e Contagem de Resultados -->
        <Border Grid.Row="3" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,8" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Dicas de Teclado (Keyboard First) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Enter" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                        </Border>
                        <TextBlock Text="Selecionar Produto" FontSize="11" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="↑ / ↓" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                        </Border>
                        <TextBlock Text="Navegar na Grade" FontSize="11" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Esc" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                        </Border>
                        <TextBlock Text="Voltar ao Pedido" FontSize="11" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Total de Produtos Exibidos -->
                <TextBlock Grid.Column="1" Text="{Binding TotalEncontrados}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
