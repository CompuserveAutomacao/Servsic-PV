<UserControl
    x:Class="ServsicPV.Views.ProdutoConsultaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d">
    <Grid Background="{StaticResource BrushIceBackground}" Padding="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Cabeçalho Superior: Título, Contagem & Botão no Topo -->
            <RowDefinition Height="*"/>    <!-- 1. Área Principal: Grade (Esquerda) + Card Detalhes (Direita) -->
        </Grid.RowDefinitions>
        <!-- 0. Cabeçalho Superior da Tela: Título e Botão Livres no Topo -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Lado Esquerdo: Identidade da Tela com Ícone -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource BrushServsicBlueSoft}" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="BoxSearch" FontSize="22" Foreground="{StaticResource BrushServsicBlue}"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Consulta de Produtos" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                    </StackPanel>
                    <TextBlock Text="Pesquisa inteligente por Descrição, Grupo, Marca/Fabricante, Código e Localização" FontSize="12" Foreground="{StaticResource BrushTextSubtle}"/>
                </StackPanel>
            </StackPanel>
            <!-- Lado Direito: Botão Voltar ao Pedido -->
            <Button Grid.Column="1" Command="{Binding VoltarAoPedidoCommand}" Style="{StaticResource BtnSecondary}" Height="38" Padding="16,0" ToolTipService.ToolTip="Voltar ao Pedido de Venda (Esc)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:SymbolIcon Symbol="ArrowLeft" FontSize="16"/>
                    <TextBlock Text="Voltar (Esc)" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>
        <!-- 1. Área Principal: Grade com Barra à Esquerda e Ficha Técnica Ocupando Toda Altura à Direita -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>     <!-- Esquerda: Barra de Pesquisa + Grade de Produtos -->
                <ColumnDefinition Width="340"/>   <!-- Direita: Ficha Técnica Total de Alto a Baixo -->
            </Grid.ColumnDefinitions>
            <!-- 1.1 COLUNA ESQUERDA: Barra de Pesquisa + Grade de Produtos -->
            <Grid Grid.Column="0" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Barra de Pesquisa Apenas Sobre a Grade -->
                    <RowDefinition Height="*"/>    <!-- Grade de Produtos -->
                </Grid.RowDefinitions>
                <!-- Barra de Pesquisa + Filtros Expansíveis -->
                <StackPanel Grid.Row="0" Spacing="6">
                    <!-- Barra de Pesquisa Principal (Foco em Códigos e Descrição) -->
                    <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <ic:SymbolIcon Grid.Column="0" Symbol="Search" FontSize="18" Foreground="{StaticResource BrushServsicBlue}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                            
                            <TextBox x:Name="TxtFiltro" Grid.Column="1"
                                     Text="{Binding FiltroTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="TxtFiltro_KeyDown"
                                     PlaceholderText="Buscar por código (Controle, EAN, Cód. Interno, Ref.) ou descrição do produto..."
                                     Height="36" VerticalAlignment="Center"
                                     BorderThickness="0" Background="Transparent"/>
                            <!-- Botão Limpar Texto da Busca Principal -->
                            <Button Grid.Column="2"
                                    Command="{Binding LimparFiltroCommand}"
                                    Visibility="{Binding FiltroTexto, Converter={StaticResource StringToVisibilityConverter}}"
                                    Background="Transparent" BorderThickness="0" Padding="6,4"
                                    ToolTipService.ToolTip="Limpar busca principal">
                                <ic:SymbolIcon Symbol="Dismiss" FontSize="14" Foreground="#94A3B8"/>
                            </Button>
                            <!-- Botão de Alternar Filtros Expansíveis (Marca, Grupo, Localização) -->
                            <Button Grid.Column="3"
                                    Command="{Binding AlternarFiltrosCommand}"
                                    Background="{StaticResource BrushIceBackground}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    ToolTipService.ToolTip="Abrir filtros adicionais (Marca, Grupo, Localização)">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ic:SymbolIcon Symbol="Filter" FontSize="14" Foreground="{StaticResource BrushServsicBlue}"/>
                                    <TextBlock Text="Filtros" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                    <!-- Pílula/Badge caso haja filtros avançados preenchidos -->
                                    <Border Background="{StaticResource BrushServsicBlue}" CornerRadius="10" Padding="6,1"
                                            Visibility="{Binding HasFiltrosAvancados, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Ativos" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                    <ic:SymbolIcon Symbol="ChevronDown" FontSize="12" Foreground="#64748B"
                                                  Visibility="{Binding IsFiltrosExpandidos, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <ic:SymbolIcon Symbol="ChevronUp" FontSize="12" Foreground="#64748B"
                                                  Visibility="{Binding IsFiltrosExpandidos, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- Painel Expansível de Filtros Avançados (Marca, Grupo, Localização) -->
                    <Border Visibility="{Binding IsFiltrosExpandidos, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{StaticResource BrushCardBackground}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Cabeçalho do Painel de Filtros -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ic:SymbolIcon Symbol="Filter" FontSize="14" Foreground="{StaticResource BrushServsicBlue}"/>
                                    <TextBlock Text="Filtros de Refinamento (digite para filtrar imediatamente):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding LimparFiltrosAvancadosCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6,2"
                                        ToolTipService.ToolTip="Limpar campos de marca, grupo e localização">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ic:SymbolIcon Symbol="Dismiss" FontSize="12" Foreground="#EF4444"/>
                                        <TextBlock Text="Limpar Filtros" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <!-- Campos de Seleção: Marca, Grupo, Localização -->
                            <Grid Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 1. Marca / Fabricante -->
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Marca / Fabricante:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <ComboBox x:Name="CmbFiltroMarca"
                                              ItemsSource="{Binding MarcasDisponiveis}"
                                              SelectedItem="{Binding FiltroMarca, Mode=TwoWay}"
                                              KeyDown="FiltroAvancado_KeyDown"
                                              HorizontalAlignment="Stretch"
                                              Height="32" FontSize="12"
                                              Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="4"/>
                                </StackPanel>
                                <!-- 2. Grupo / Setor -->
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Grupo / Categoria:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <ComboBox x:Name="CmbFiltroGrupo"
                                              ItemsSource="{Binding GruposDisponiveis}"
                                              SelectedItem="{Binding FiltroGrupo, Mode=TwoWay}"
                                              KeyDown="FiltroAvancado_KeyDown"
                                              HorizontalAlignment="Stretch"
                                              Height="32" FontSize="12"
                                              Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="4"/>
                                </StackPanel>
                                <!-- 3. Localização no Estoque -->
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Localização no Estoque:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <ComboBox x:Name="CmbFiltroLocalizacao"
                                              ItemsSource="{Binding LocalizacoesDisponiveis}"
                                              SelectedItem="{Binding FiltroLocalizacao, Mode=TwoWay}"
                                              KeyDown="FiltroAvancado_KeyDown"
                                              HorizontalAlignment="Stretch"
                                              Height="32" FontSize="12"
                                              Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="4"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
                <!-- Grade de Produtos em Cards Distintos com Borda e Fundo Contrastante -->
                <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="6">
                    <Grid>
                        <ProgressBar IsIndeterminate="True" 
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                     VerticalAlignment="Top" Margin="0,-6,0,0"/>
                        <ListView x:Name="ListaProdutos"
                                  ItemsSource="{Binding Produtos}"
                                  SelectedItem="{Binding ProdutoSelecionado, Mode=TwoWay}"
                                  SingleSelectionFollowsFocus="True"
                                  IsItemClickEnabled="True"
                                  DoubleTapped="ListaProdutos_DoubleTapped"
                                  BorderThickness="0"
                                  SelectionMode="Single">
                            <ListView.Resources>
                                <!-- Cores Nativas do Card e Estados de Foco/Seleção do WinUI 3 -->
                                <SolidColorBrush x:Key="ListViewItemBackground" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="ListViewItemBorderBrush" Color="#CBD5E1"/>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="ListViewItemBorderBrushPointerOver" Color="#0284C7"/>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#F0F9FF"/>
                                <SolidColorBrush x:Key="ListViewItemBorderBrushSelected" Color="#0284C7"/>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#E0F2FE"/>
                                <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPointerOver" Color="#0284C7"/>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#BAE6FD"/>
                                <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPressed" Color="#0369A1"/>
                                
                                <!-- Indicador Lateral Azul Corporativo (Selection Pill do WinUI) -->
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#0284C7"/>
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#0284C7"/>
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#0369A1"/>
                                
                                <!-- Elimina o retângulo preto de foco do Windows -->
                                <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent"/>
                                <Thickness x:Key="ListViewItemBorderThickness">1</Thickness>
                                <Thickness x:Key="ListViewItemSelectedBorderThickness">1.5</Thickness>
                                <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="14,8"/>
                                    <Setter Property="Margin" Value="0,3"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                                    <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
                                    <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- 0. Códigos: Controle e Cód. Interno -->
                                            <ColumnDefinition Width="Auto"/> <!-- 1. Divisória -->
                                            <ColumnDefinition Width="*"/>    <!-- 2. Nome do Produto em Amplo Destaque -->
                                            <ColumnDefinition Width="Auto"/> <!-- 3. Divisória -->
                                            <ColumnDefinition Width="Auto"/> <!-- 4. Desconto Máximo (Card 1) -->
                                            <ColumnDefinition Width="Auto"/> <!-- 5. Preço (Card 2) -->
                                        </Grid.ColumnDefinitions>
                                        <!-- 0. Códigos (Controle e Cód. Interno / EAN) -->
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center" MinWidth="90">
                                            <!-- CÓD (Controle) -->
                                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="5" Padding="7,2" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="CÓD" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                                    <TextBlock Text="{Binding CodigoFormatado}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- CÓD. INTERNO / EAN -->
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="6,1.5" HorizontalAlignment="Left"
                                                    Visibility="{Binding HasEan, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <ic:SymbolIcon Symbol="BarcodeScanner" FontSize="10.5" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding Ean}" FontSize="10" FontWeight="SemiBold" Foreground="#334155"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <!-- 1. Divisória -->
                                        <Border Grid.Column="1" Width="1" Background="#E2E8F0" Height="36" VerticalAlignment="Center"/>
                                        <!-- 2. Nome do Produto com Grande Espaço Livre, Quebra em até 2 Linhas e Vermelho se Sem Estoque -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Descricao}" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="{Binding NomeForeground}" 
                                                   VerticalAlignment="Center" 
                                                   TextWrapping="Wrap" 
                                                   MaxLines="2" 
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- 3. Divisória -->
                                        <Border Grid.Column="3" Width="1" Background="#E2E8F0" Height="36" VerticalAlignment="Center"/>
                                        <!-- 4. CARD 1: Desconto Máximo -->
                                        <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Center" MinWidth="85">
                                            <StackPanel Spacing="1" HorizontalAlignment="Center">
                                                <TextBlock Text="DESC. MÁX" FontSize="7.5" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="30" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding PerDescMaxValorFormatado}" FontSize="13.5" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 5. CARD 2: Preço -->
                                        <Border Grid.Column="5" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="14,4" VerticalAlignment="Center" MinWidth="95">
                                            <StackPanel Spacing="1" HorizontalAlignment="Center">
                                                <TextBlock Text="PREÇO" FontSize="7.5" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}" CharacterSpacing="30" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding PrVendaFormatado}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <!-- Mensagem quando vazio -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    Visibility="{Binding Mensagem, Converter={StaticResource StringToVisibilityConverter}}">
                            <ic:SymbolIcon Symbol="Search" FontSize="32" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Mensagem}" FontSize="13" Foreground="{StaticResource BrushTextSubtle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- 1.2 COLUNA DIREITA: Ficha Técnica Detalhada do Produto (Ocupa Toda a Altura Vertical!) -->
            <Border Grid.Column="1" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Cabeçalho do Card -->
                        <RowDefinition Height="*"/>    <!-- Conteúdo Scrollável: Imagem + Seções -->
                        <RowDefinition Height="Auto"/> <!-- Botão de Confirmação no Rodapé -->
                    </Grid.RowDefinitions>
                    <!-- Cabeçalho do Card -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ic:SymbolIcon Symbol="DocumentLandscapeData" FontSize="18" Foreground="{StaticResource BrushServsicBlue}"/>
                        <TextBlock Text="Ficha Detalhada do Produto" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                    </StackPanel>
                    <!-- Detalhes do Produto -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Visibility="{Binding HasProdutoSelecionado, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Visualizador da Imagem do Produto -->
                            <Border Height="150" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="4">
                                <Grid>
                                    <!-- Imagem Real Carregada do Banco -->
                                    <Image Source="{Binding FotoBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasFoto, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <!-- Placeholder quando sem imagem -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                                Visibility="{Binding HasFoto, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <ic:SymbolIcon Symbol="Image" FontSize="32" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sem imagem cadastrada" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Descrição Completa -->
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="12,8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="DESCRIÇÃO DO PRODUTO" FontSize="9" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="50"/>
                                    <TextBlock Text="{Binding ProdutoDetalhe.Descricao}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <!-- 1. SEÇÃO: ESTOQUE (LOJA & DEPÓSITO) -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ic:SymbolIcon Symbol="Box" FontSize="14" Foreground="{StaticResource BrushServsicBlue}"/>
                                        <TextBlock Text="ESTOQUE POR LOCAL" FontSize="10" FontWeight="Bold" Foreground="#475569" CharacterSpacing="40"/>
                                    </StackPanel>
                                    <!-- Estoque Total Geral em Destaque -->
                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="ESTOQUE TOTAL GERAL" FontSize="8.5" FontWeight="Bold" Foreground="#047857" CharacterSpacing="30"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.EstoqueTotalFormatado}" FontSize="16" FontWeight="Bold" Foreground="#065F46"/>
                                            </StackPanel>
                                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#059669" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Grid Loja e Depósito -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Estoque Loja (Frente de Caixa) -->
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Estoque Loja" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.EstoqueLojaFormatado}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Estoque Depósito -->
                                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Estoque Depósito" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.EstoqueDepositoFormatado}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <!-- Estoque Mínimo -->
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Estoque Mínimo Cadastrado:" FontSize="10.5" Foreground="{StaticResource BrushTextSubtle}"/>
                                        <TextBlock Text="{Binding ProdutoDetalhe.EstMinimoFormatado}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- 2. SEÇÃO: TABELA DE PREÇOS (VAREJO & ATACADO) -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ic:SymbolIcon Symbol="TagMultiple" FontSize="14" Foreground="{StaticResource BrushServsicBlue}"/>
                                        <TextBlock Text="TABELA DE PREÇOS (VAREJO &amp; ATACADO)" FontSize="10" FontWeight="Bold" Foreground="#475569" CharacterSpacing="40"/>
                                    </StackPanel>
                                    <!-- Linha 1: Preço Venda (Varejo) e Preço Atacado -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Preço de Venda / Varejo -->
                                        <Border Grid.Column="0" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="PREÇO VAREJO (À VISTA)" FontSize="8" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}" CharacterSpacing="30"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.PrVendaFormatado}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Preço Atacado -->
                                        <Border Grid.Column="1" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="PREÇO ATACADO" FontSize="8" FontWeight="Bold" Foreground="#92400E" CharacterSpacing="30"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.PrAtacadoFormatado}" FontSize="15" FontWeight="Bold" Foreground="#92400E"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <!-- Linha 2: A Prazo e Preço Mínimo -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Preço a Prazo -->
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Preço a Prazo" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.PrPrazoFormatado}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Preço Mínimo de Venda -->
                                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Preço Mínimo" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.PrMinimoFormatado}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <!-- Regra de Quantidade Mínima para Atacado -->
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Regra de Atacado:" FontSize="10" Foreground="{StaticResource BrushTextSubtle}"/>
                                            <TextBlock Text="{Binding ProdutoDetalhe.RegraAtacadoDescricao}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- 3. SEÇÃO: CÓDIGOS DE IDENTIFICAÇÃO (ERP LEGADO & FISCAL) -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ic:SymbolIcon Symbol="BarcodeScanner" FontSize="14" Foreground="{StaticResource BrushServsicBlue}"/>
                                        <TextBlock Text="CÓDIGOS DE IDENTIFICAÇÃO" FontSize="10" FontWeight="Bold" Foreground="#475569" CharacterSpacing="40"/>
                                    </StackPanel>
                                    <!-- Linha 1: Controle (ID) e Código / Cód. Barras (EAN) -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Controle (ID) -->
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Controle (ID)" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.ControleTexto}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Código / Cód. Barras (EAN) -->
                                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Cód. / Barras (EAN)" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.EanFormatado}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <!-- Linha 2: Cód Atacado/Origem e Cód. Barras Adicional -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Cód. Atacado / Origem -->
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Cód. Origem / Atacado" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.CodOrigemFormatado}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Cód. Barras Adicional -->
                                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Cód. Barras Adicional" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.CodBarraAdicionalFormatado}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <!-- Linha 3: Cód. Caixa/Atacado e Cód. Fornecedor -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Cód. Caixa / Atacado -->
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Cód. Caixa / Atacado" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.CodBarraCxFormatado}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Cód. Fornecedor -->
                                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Cód. Fornecedor" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.CodFornecedorFormatado}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <!-- Linha 4: NCM e CEST (Fiscal) -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- NCM -->
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="NCM (Classificação)" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.NcmFormatado}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- CEST -->
                                        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="CEST" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ProdutoDetalhe.CestFormatado}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Localização Física (Campo Moeda da TabEst1) -->
                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ic:SymbolIcon Grid.Column="0" Symbol="Location" FontSize="18" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="LOCALIZAÇÃO NO ESTOQUE" FontSize="8.5" FontWeight="Bold" Foreground="#B45309" CharacterSpacing="30"/>
                                        <TextBlock Text="{Binding ProdutoDetalhe.LocalizacaoFormatada}" FontSize="12.5" FontWeight="Bold" Foreground="#78350F"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Apresentação / Embalagem -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="APRESENTAÇÃO / EMBALAGEM" FontSize="8.5" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="30"/>
                                    <TextBlock Text="{Binding ProdutoDetalhe.ApresentacaoFormatada}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>
                            </Border>
                            <!-- Ficha Técnica e Metadados -->
                            <StackPanel Spacing="6">
                                <!-- Unidade de Medida -->
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Unidade de Medida" FontSize="10.5" Foreground="{StaticResource BrushTextSubtle}"/>
                                    <TextBlock Text="{Binding ProdutoDetalhe.Unidade}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>
                                <!-- Marca / Fabricante -->
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Marca / Fabricante" FontSize="10.5" Foreground="{StaticResource BrushTextSubtle}"/>
                                    <TextBlock Text="{Binding ProdutoDetalhe.FabricanteFormatado}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>
                                <!-- Grupo / Setor -->
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Grupo / Setor" FontSize="10.5" Foreground="{StaticResource BrushTextSubtle}"/>
                                    <TextBlock Text="{Binding ProdutoDetalhe.GrupoFormatado}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>
                                <!-- Subgrupo -->
                                <StackPanel Spacing="1" Visibility="{Binding ProdutoDetalhe.SubGrupo, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="Subgrupo" FontSize="10.5" Foreground="{StaticResource BrushTextSubtle}"/>
                                    <TextBlock Text="{Binding ProdutoDetalhe.SubGrupo}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                </StackPanel>
                                <!-- Desconto Máximo Permitido -->
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Desconto Máximo Permitido" FontSize="10.5" Foreground="{StaticResource BrushTextSubtle}"/>
                                    <TextBlock Text="{Binding ProdutoDetalhe.PerDescMaxFormatado}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushServsicBlue}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Botão de Ação: Selecionar Produto -->
                    <Button Grid.Row="2" Command="{Binding ConfirmarSelecaoCommand}" Style="{StaticResource BtnPrimary}" Height="40" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Checkmark" FontSize="16"/>
                            <TextBlock Text="Inserir no Pedido (Enter)" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
