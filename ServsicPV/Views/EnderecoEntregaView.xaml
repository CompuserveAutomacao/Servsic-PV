<UserControl
    x:Class="ServsicPV.Views.EnderecoEntregaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    KeyDown="EnderecoEntregaView_KeyDown">

    <!-- Fundo Overlay Escuro Translúcido -->
    <Grid Background="#B30B192C">
        <!-- Card Central do Modal: Compacto e Otimizado para Telas Menores (1366x768 / 1024x768) -->
        <Border Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="10"
                Width="630"
                MaxHeight="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="16,12">

            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0. Cabeçalho -->
                    <RowDefinition Height="*"/>    <!-- 1. Corpo com ScrollViewer -->
                    <RowDefinition Height="Auto"/> <!-- 2. Rodapé com Ações -->
                </Grid.RowDefinitions>

                <!-- 0. Cabeçalho do Modal -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="6" Background="{StaticResource BrushServsicBlueSoft}" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="VehicleTruck" FontSize="18" Foreground="{StaticResource BrushServsicBlue}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Endereço de Entrega do Pedido" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                <Border Background="#E0F2FE" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+E" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrushServsicBlue}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding NomeClienteExibicao}" FontSize="11.5" Foreground="{StaticResource BrushTextSubtle}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding FecharCommand}" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="6" ToolTipService.ToolTip="Fechar (Esc)">
                        <ic:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="#64748B"/>
                    </Button>
                </Grid>

                <!-- 1. Corpo de Conteúdo com Rolagem Flexível -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8" Padding="0,2,6,2">

                        <!-- Seção A: Barra de Destinos / Endereço Principal (Apenas quando cliente vinculado) -->
                        <Border Visibility="{Binding HasCliente, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Quando possui destinos salvos -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                            Visibility="{Binding HasEnderecosCadastrados, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ic:SymbolIcon Symbol="Building" FontSize="14" Foreground="{StaticResource BrushServsicBlue}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Destinos Salvos:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding EnderecosCadastrados}"
                                              SelectedItem="{Binding SelectedDestino, Mode=TwoWay}"
                                              DisplayMemberPath="ApelidoComEndereco"
                                              PlaceholderText="Selecione um destino salvo..."
                                              Width="300" Height="28" FontSize="11.5"
                                              VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Quando não possui destinos adicionais -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                            Visibility="{Binding HasEnderecosCadastrados, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <ic:SymbolIcon Symbol="Building" FontSize="14" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Nenhum destino adicional cadastrado para este cliente." FontSize="11" Foreground="{StaticResource BrushTextSubtle}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding UsarEnderecoPrincipalCommand}" 
                                        Style="{StaticResource BtnSecondary}" Height="28" Padding="8,0" 
                                        ToolTipService.ToolTip="Preencher com o endereço principal do cliente">
                                    <TextBlock Text="Usar Cadastro Principal" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Seção B: Formulário Compacto de Dados de Entrega -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Dados da Entrega no Pedido" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource BrushTextDark}"/>

                                <!-- Linha 1: CEP + Botão Buscar CEP + Status + Botão Maps -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="CEP" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                        <TextBox x:Name="TxtCep"
                                                 Text="{Binding Cep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="TxtCep_KeyDown"
                                                 PlaceholderText="00000-000"
                                                 Height="28" FontSize="11.5"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" 
                                            Command="{Binding BuscarCepCommand}"
                                            Style="{StaticResource BtnSecondary}"
                                            Height="28" Padding="10,0" VerticalAlignment="Bottom"
                                            ToolTipService.ToolTip="Consultar CEP online (ViaCEP)">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ic:SymbolIcon Symbol="Search" FontSize="13" Foreground="{StaticResource BrushServsicBlue}"/>
                                            <TextBlock Text="Buscar CEP" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Status / Mensagem da busca -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding MensagemStatus}" 
                                               FontSize="11" 
                                               Foreground="{StaticResource BrushServsicBlue}" 
                                               VerticalAlignment="Bottom" 
                                               Margin="4,0,4,5"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Botão Ver no Google Maps -->
                                    <Button Grid.Column="3"
                                            Command="{Binding AbrirGoogleMapsCommand}"
                                            Style="{StaticResource BtnSecondary}"
                                            Height="28" Padding="10,0" VerticalAlignment="Bottom"
                                            ToolTipService.ToolTip="Abrir endereço no Google Maps">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ic:SymbolIcon Symbol="Map" FontSize="14" Foreground="{StaticResource BrushServsicBlue}"/>
                                            <TextBlock Text="Ver no Maps" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Linha 2: Endereço / Logradouro + Número -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Endereço / Logradouro" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                        <TextBox Text="{Binding Endereco, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Ex: Rua das Flores, Av. Brasil"
                                                 Height="28" FontSize="11.5"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Número" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                        <TextBox Text="{Binding Numero, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Ex: 123"
                                                 Height="28" FontSize="11.5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Linha 3: Complemento + Bairro -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Complemento" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                        <TextBox Text="{Binding ComplEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Ex: Apto 101, Galpão A"
                                                 Height="28" FontSize="11.5"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Bairro" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                        <TextBox Text="{Binding Bairro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Ex: Centro, Industrial"
                                                 Height="28" FontSize="11.5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Linha 4: Cidade + UF -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="55"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Cidade" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                        <TextBox Text="{Binding Cidade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Ex: Tucuruí"
                                                 Height="28" FontSize="11.5"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="UF" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                        <TextBox Text="{Binding Estado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="PA"
                                                 MaxLength="2"
                                                 Height="28" FontSize="11.5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Linha 5: Ponto de Referência / Instruções -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Ponto de Referência / Instruções de Entrega" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                                    <TextBox Text="{Binding Obs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Ex: Próximo à praça central, portão verde"
                                             Height="28" FontSize="11.5"/>
                                </StackPanel>

                                <!-- Linha 6: Opção de salvar como novo destino (se cliente cadastrado) -->
                                <Grid Visibility="{Binding HasCliente, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding SalvarNovoDestinoNoCadastro, Mode=TwoWay}"
                                              Content="Salvar como novo destino do cliente:"
                                              FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"
                                              Margin="0,0,8,0" VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1"
                                             Visibility="{Binding SalvarNovoDestinoNoCadastro, Converter={StaticResource BoolToVisibilityConverter}}"
                                             Text="{Binding ApelidoNovo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Nome do destino (Ex: OBRA CENTRO, FAZENDA)"
                                             Height="28" FontSize="11.5"
                                             VerticalAlignment="Center"/>
                                </Grid>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 2. Rodapé com Ações Compacto -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding LimparEnderecoCommand}" Style="{StaticResource BtnSecondary}" Height="32" Padding="12,0" ToolTipService.ToolTip="Limpar dados de entrega">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Delete" FontSize="14" Foreground="{StaticResource BrushDanger}"/>
                            <TextBlock Text="Limpar Endereço" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Command="{Binding FecharCommand}" Style="{StaticResource BtnSecondary}" Height="32" Padding="14,0" Margin="0,0,8,0" ToolTipService.ToolTip="Cancelar e Fechar (Esc)">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0B192C"/>
                            <SolidColorBrush x:Key="ButtonBackgroundFocused" Color="#0B192C"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonForegroundFocused" Color="#FFFFFF"/>
                        </Button.Resources>
                        <TextBlock Text="Voltar (Esc)" FontSize="11.5" FontWeight="SemiBold"/>
                    </Button>

                    <Button Grid.Column="3" Command="{Binding ConfirmarCommand}" Style="{StaticResource BtnPrimary}" Height="32" Padding="16,0" ToolTipService.ToolTip="Confirmar endereço no pedido (Enter)">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#0284C7"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0B192C"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#07111E"/>
                            <SolidColorBrush x:Key="ButtonBackgroundFocused" Color="#0B192C"/>
                            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonForegroundFocused" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#0B192C"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushFocused" Color="#0B192C"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Checkmark" FontSize="15" Foreground="#FFFFFF"/>
                            <TextBlock Text="Confirmar Endereço (Enter)" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
