<Window
    x:Class="ServsicPV.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:views="using:ServsicPV.Views"
    mc:Ignorable="d"
    Title="ServsicPV - Login">

    <Grid x:Name="RootGrid" Background="{StaticResource BrushIceBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Painel Esquerdo: Identidade Visual ServSic -->
        <Grid Grid.Column="0" Background="{StaticResource BrushServsicDark}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <!-- Imagem da Logo Oficial do Sistema -->
                <Image Source="ms-appx:///Assets/logo.png" Width="200" Height="200" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                
                <!-- Logo Tipográfica Compu (Branco) + serve (Vermelho) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Compu" FontSize="40" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="serve" FontSize="40" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#EF4444"/>
                </StackPanel>

                <!-- Subtítulo Suave -->
                <TextBlock Text="Soluções em tecnologia comercial" 
                           Foreground="#94A3B8" 
                           FontSize="13" 
                           FontFamily="Segoe UI"
                           FontWeight="Normal"
                           HorizontalAlignment="Center"/>

                <!-- Versão do Sistema -->
                <TextBlock Text="{Binding AtualizacaoViewModel.CurrentVersion}" 
                           Foreground="#64748B" FontSize="11" 
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Painel Direito: Formulário de Autenticação -->
        <Grid Grid.Column="1" Margin="48,24,48,20">
            <!-- Ações no Canto Superior Direito: Atualizações e Configuração -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Spacing="4">
                <Button Command="{Binding AtualizacaoViewModel.VerificarCommand}"
                        Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="6"
                        ToolTipService.ToolTip="Verificar Atualizações do Sistema">
                    <ic:SymbolIcon Symbol="ArrowSync" FontSize="19" Foreground="{StaticResource BrushTextSubtle}"/>
                </Button>
                <Button x:Name="BtnConfig"
                        Click="BtnConfig_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        CornerRadius="6"
                        ToolTipService.ToolTip="Configuração do Banco de Dados (Servcom.dll)">
                    <ic:SymbolIcon Symbol="Settings" FontSize="20" Foreground="{StaticResource BrushTextSubtle}"/>
                </Button>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" Spacing="20" MaxWidth="340" HorizontalAlignment="Center">
                
                <StackPanel Spacing="6">
                    <TextBlock Text="Bem-vindo ao ServSic!" Style="{StaticResource TextHeader}"/>
                    <TextBlock Text="Selecione seu usuário cadastrado e insira sua senha." Style="{StaticResource TextSubheader}"/>
                </StackPanel>

                <!-- Seleção do Usuário -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Usuário" Style="{StaticResource TextLabel}"/>
                    <ComboBox x:Name="CmbUsuarios"
                              ItemsSource="{Binding ActiveUsers}"
                              SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                              SelectionChanged="CmbUsuarios_SelectionChanged"
                              DisplayMemberPath="Nome"
                              PlaceholderText="Selecione seu usuário"
                              HorizontalAlignment="Stretch"
                              Height="42"
                              FontSize="14"/>
                </StackPanel>

                <!-- Input de Senha -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Senha" Style="{StaticResource TextLabel}"/>
                    <PasswordBox x:Name="TxtPassword"
                                 Password="{Binding Password, Mode=TwoWay}"
                                 KeyDown="TxtPassword_KeyDown"
                                 PlaceholderText="Digite sua senha"
                                 Height="42"
                                 FontSize="14"
                                 CornerRadius="6"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Alerta de Erro -->
                <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12,8"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Warning" FontSize="18" Foreground="{StaticResource BrushDanger}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" FontSize="12.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Botão de Login -->
                <Button Content="Acessar o Sistema"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource BtnPrimary}"
                        Height="44"
                        Margin="0,4,0,0"/>

                <ProgressRing IsActive="{Binding IsBusy}" HorizontalAlignment="Center" Width="30" Height="30"
                              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

            </StackPanel>
        </Grid>

        <!-- Modal de Configuração Manual do Banco de Dados (Servcom.dll) -->
        <Grid x:Name="ConfigOverlay" 
              Grid.Column="0" Grid.ColumnSpan="2" 
              Canvas.ZIndex="999"
              Background="#800B192C"
              Visibility="{Binding IsConfigOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="480" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Background="#FFFFFF" 
                    CornerRadius="10" 
                    BorderBrush="{StaticResource BrushBorder}" 
                    BorderThickness="1" 
                    Padding="24">
                <StackPanel Spacing="16">
                    <!-- Cabeçalho do Modal -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{StaticResource BrushServsicBlueSoft}" CornerRadius="6" Padding="6">
                                <ic:SymbolIcon Symbol="Database" FontSize="22" Foreground="{StaticResource BrushServsicBlue}"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Conectar Manualmente ao Banco" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                <TextBlock Text="Salvar cria ou atualiza o arquivo Servcom.dll automaticamente" FontSize="11.5" Foreground="{StaticResource BrushTextSubtle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Click="BtnFecharConfig_Click" Background="Transparent" BorderThickness="0" Padding="4">
                            <ic:SymbolIcon Symbol="Dismiss" FontSize="18" Foreground="{StaticResource BrushTextSubtle}"/>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BrushBorder}"/>

                    <!-- Origem do Servcom.dll -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ic:SymbolIcon Grid.Column="0" Symbol="DocumentBulletList" FontSize="16" Foreground="{StaticResource BrushServsicBlue}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Origem do Servcom.dll:" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSubtle}"/>
                                <TextBlock Text="{Binding ConfigFilePath, Mode=OneWay}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource BrushTextDark}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Campos de Conexão -->
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Servidor / Instância (Host ou IP)" Style="{StaticResource TextLabel}"/>
                            <TextBox Text="{Binding ConfigServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     PlaceholderText="Ex: .\qg ou localhost ou 192.168.1.10\SERVSIC" 
                                     Height="36"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Nome do Banco de Dados" Style="{StaticResource TextLabel}"/>
                            <TextBox Text="{Binding ConfigDatabase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     PlaceholderText="Ex: prod silcon" 
                                     Height="36"/>
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Usuário SQL" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding ConfigUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         PlaceholderText="Ex: sa" 
                                         Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Senha SQL" Style="{StaticResource TextLabel}"/>
                                <PasswordBox x:Name="TxtConfigPassword" 
                                             PlaceholderText="Senha do banco" 
                                             Height="36"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Mensagem de Retorno do Teste / Gravação -->
                    <Border Visibility="{Binding ConfigStatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                            Background="{Binding IsConfigSuccess, Converter={StaticResource StatusColorConverter}}"
                            CornerRadius="6" Padding="12,8">
                        <TextBlock Text="{Binding ConfigStatusMessage}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Barra de Ações -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="BtnTestarConexao_Click" Style="{StaticResource BtnSecondary}" Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="16"/>
                                <TextBlock Text="Testar Conexão"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="Cancelar" Click="BtnFecharConfig_Click" Style="{StaticResource BtnSecondary}" Height="36"/>
                            <Button Click="BtnSalvarConfig_Click" Style="{StaticResource BtnPrimary}" Height="36" Padding="16,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Save" FontSize="16"/>
                                    <TextBlock Text="Salvar e Conectar"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- MODAL DE ATUALIZAÇÃO AUTOMÁTICA                                -->
        <!-- ============================================================== -->
        <views:AtualizacaoModalView Grid.Column="0" Grid.ColumnSpan="2"
                                    DataContext="{Binding AtualizacaoViewModel}"/>
    </Grid>
</Window>
