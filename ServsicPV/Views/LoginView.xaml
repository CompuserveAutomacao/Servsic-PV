<Window
    x:Class="ServsicPV.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    Title="ServsicPV - Autenticação">

    <!-- Borda externa da tela para acabamento sem janela padrão (Formato Quadrado) -->
    <Border BorderBrush="#1E293B" BorderThickness="1" Background="{StaticResource BrushCardBackground}">
        <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. Cabeçalho Executivo Navy (Permite Arrastar) -->
                <RowDefinition Height="*"/>    <!-- 1. Corpo de Autenticação -->
                <RowDefinition Height="Auto"/> <!-- 2. Rodapé de Status e Conexão -->
            </Grid.RowDefinitions>

            <!-- ============================================================== -->
            <!-- 0. CABEÇALHO EXECUTIVO (Navy Oficial ServSic / Área de Arraste) -->
            <!-- ============================================================== -->
            <Border Grid.Row="0" 
                    Background="{StaticResource BrushServsicDark}" 
                    Padding="20,16,16,14"
                    PointerPressed="Header_PointerPressed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logotipo Oficial Compacto -->
                    <Border Grid.Column="0" 
                            Width="40" Height="40" 
                            Background="#1E293B" 
                            BorderBrush="#334155" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/logo.png" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Marca Tipográfica Oficial e Subtítulo -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Compu" FontSize="20" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="serve" FontSize="20" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                        <TextBlock Text="SERVSIC PV • PONTO DE VENDA" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" CharacterSpacing="60"/>
                    </StackPanel>

                    <!-- Botões Superiores: Configuração e Fechar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Botão de Configuração de Banco -->
                        <Button x:Name="BtnConfig"
                                Click="BtnConfig_Click"
                                IsTabStop="False"
                                Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                Padding="7"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Configurações de Conexão com o Banco de Dados">
                            <ic:SymbolIcon Symbol="Settings" FontSize="15" Foreground="#CBD5E1"/>
                        </Button>

                        <!-- Botão Fechar Janela (X) -->
                        <Button Click="BtnSair_Click"
                                IsTabStop="False"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="7"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Fechar (Esc)">
                            <ic:SymbolIcon Symbol="Dismiss" FontSize="15" Foreground="#94A3B8"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- 1. CORPO DE AUTENTICAÇÃO (Branco Puro com Design Moderno)       -->
            <!-- ============================================================== -->
            <Grid Grid.Row="1" Padding="28,20,28,18">
                <StackPanel Spacing="15" VerticalAlignment="Center">
                    
                    <!-- Título e Subtítulo -->
                    <StackPanel Spacing="3">
                        <TextBlock Text="Identificação do Operador" FontSize="16.5" FontFamily="Segoe UI Semibold" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                        <TextBlock Text="Selecione seu usuário e digite sua senha de caixa." FontSize="12.5" Foreground="{StaticResource BrushTextSubtle}"/>
                    </StackPanel>

                    <!-- Campo 1: Seleção do Usuário -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Person" FontSize="14" Foreground="{StaticResource BrushServsicBlue}"/>
                            <TextBlock Text="Operador / Usuário" FontSize="12" FontFamily="Segoe UI Semibold" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                        </StackPanel>
                        <ComboBox x:Name="CboUsuario"
                                  ItemsSource="{Binding ActiveUsers}"
                                  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                  DisplayMemberPath="Nome"
                                  KeyDown="CboUsuario_KeyDown"
                                  PlaceholderText="Selecione o operador..."
                                  HorizontalAlignment="Stretch"
                                  Height="42"
                                  FontSize="13.5"
                                  CornerRadius="8"/>
                    </StackPanel>

                    <!-- Campo 2: Senha de Acesso -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Key" FontSize="14" Foreground="{StaticResource BrushServsicBlue}"/>
                            <TextBlock Text="Senha de Acesso" FontSize="12" FontFamily="Segoe UI Semibold" FontWeight="SemiBold" Foreground="{StaticResource BrushTextDark}"/>
                        </StackPanel>
                        <PasswordBox x:Name="TxtPassword"
                                     Password="{Binding Password, Mode=TwoWay}"
                                     KeyDown="TxtPassword_KeyDown"
                                     PlaceholderText="Digite sua senha"
                                     Height="42"
                                     FontSize="13.5"
                                     CornerRadius="8"
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Mensagem de Erro de Autenticação -->
                    <Border Background="#FEE2E2" 
                            BorderBrush="#FCA5A5" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12,8"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ic:SymbolIcon Grid.Column="0" Symbol="DismissCircle" FontSize="16" Foreground="{StaticResource BrushDanger}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Botões de Ação: SAIR e ACESSAR O SISTEMA LADO A LADO -->
                    <Grid ColumnSpacing="10" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botão Sair -->
                        <Button Grid.Column="0"
                                x:Name="BtnSair"
                                Click="BtnSair_Click"
                                Style="{StaticResource BtnSecondary}"
                                Height="44"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Encerrar Sistema (Esc)">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <ic:SymbolIcon Symbol="Dismiss" FontSize="15" Foreground="{StaticResource BrushTextSubtle}"/>
                                <TextBlock Text="Sair (Esc)" FontFamily="Segoe UI Semibold" FontWeight="SemiBold" FontSize="13.5"/>
                            </StackPanel>
                        </Button>

                        <!-- Botão Acessar o Sistema (Sem foco branco) -->
                        <Button Grid.Column="1"
                                x:Name="BtnAcessar"
                                Command="{Binding LoginCommand}"
                                Height="44"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                BorderThickness="0"
                                Background="{StaticResource BrushServsicBlue}"
                                Foreground="#FFFFFF"
                                ToolTipService.ToolTip="Acessar o Sistema (Enter)">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="#0284C7"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0369A1"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0B192C"/>
                                <SolidColorBrush x:Key="ButtonBackgroundFocused" Color="#0B192C"/>
                                <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="ButtonForegroundFocused" Color="#FFFFFF"/>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="Acessar" FontFamily="Segoe UI Semibold" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                <ic:SymbolIcon Symbol="ArrowRight" FontSize="16" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Indicador de Carregamento -->
                    <ProgressRing IsActive="{Binding IsBusy}" 
                                  HorizontalAlignment="Center" 
                                  Width="24" Height="24"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

                </StackPanel>
            </Grid>

            <!-- ============================================================== -->
            <!-- 2. RODAPÉ DE STATUS E CONEXÃO                                   -->
            <!-- ============================================================== -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Indicador de Status com Ponto Colorido -->
                    <Border Grid.Column="0" 
                            Width="8" Height="8" 
                            CornerRadius="4" 
                            Background="{Binding IsConnected, Converter={StaticResource StatusColorConverter}}" 
                            VerticalAlignment="Center" 
                            Margin="0,0,8,0"/>

                    <TextBlock Grid.Column="1" 
                               Text="{Binding ConnectionStatus}" 
                               FontSize="11" 
                               Foreground="{StaticResource BrushTextSubtle}" 
                               VerticalAlignment="Center" 
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="2" 
                               Text="v2026" 
                               FontSize="10.5" 
                               FontWeight="SemiBold"
                               Foreground="#94A3B8" 
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- MODAL DE CONFIGURAÇÃO MANUAL DO BANCO DE DADOS (Servcom.dll)    -->
            <!-- ============================================================== -->
            <Grid x:Name="ConfigOverlay" 
                  Grid.RowSpan="3"
                  Canvas.ZIndex="999"
                  Background="#950B192C"
                  Visibility="{Binding IsConfigOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="390" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Background="#FFFFFF" 
                        CornerRadius="12" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        Padding="20">
                    <StackPanel Spacing="14">
                        <!-- Cabeçalho do Modal -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Background="{StaticResource BrushServsicBlueSoft}" CornerRadius="8" Padding="6">
                                    <ic:SymbolIcon Symbol="Database" FontSize="20" Foreground="{StaticResource BrushServsicBlue}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Conectar ao Banco" FontSize="15" FontFamily="Segoe UI Semibold" FontWeight="Bold" Foreground="{StaticResource BrushTextDark}"/>
                                    <TextBlock Text="Configuração do Servcom.dll" FontSize="11" Foreground="{StaticResource BrushTextSubtle}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Click="BtnFecharConfig_Click" Background="Transparent" BorderThickness="0" Padding="4" CornerRadius="6">
                                <ic:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{StaticResource BrushTextSubtle}"/>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BrushBorder}"/>

                        <!-- Campos de Conexão -->
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Servidor / Instância" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding ConfigServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         PlaceholderText="Ex: .\qg ou 192.168.1.10" 
                                         Height="36"
                                         CornerRadius="6"/>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Nome do Banco de Dados" Style="{StaticResource TextLabel}"/>
                                <TextBox Text="{Binding ConfigDatabase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         PlaceholderText="Ex: prod silcon" 
                                         Height="36"
                                         CornerRadius="6"/>
                            </StackPanel>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Usuário SQL" Style="{StaticResource TextLabel}"/>
                                    <TextBox Text="{Binding ConfigUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             PlaceholderText="Ex: sa" 
                                             Height="36"
                                             CornerRadius="6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Senha SQL" Style="{StaticResource TextLabel}"/>
                                    <PasswordBox x:Name="TxtConfigPassword" 
                                                 PlaceholderText="Senha" 
                                                 Height="36"
                                                 CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Mensagem de Retorno do Teste / Gravação -->
                        <Border Visibility="{Binding ConfigStatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
                                Background="{Binding IsConfigSuccess, Converter={StaticResource StatusColorConverter}}"
                                CornerRadius="6" Padding="10,6">
                            <TextBlock Text="{Binding ConfigStatusMessage}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Barra de Ações -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="BtnTestarConexao_Click" Style="{StaticResource BtnSecondary}" Height="36">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="15"/>
                                    <TextBlock Text="Testar" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Cancelar" Click="BtnFecharConfig_Click" Style="{StaticResource BtnSecondary}" Height="36"/>
                                <Button Click="BtnSalvarConfig_Click" Style="{StaticResource BtnPrimary}" Height="36" Padding="14,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Save" FontSize="15"/>
                                    <TextBlock Text="Salvar" FontWeight="Bold"/>
                                </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
