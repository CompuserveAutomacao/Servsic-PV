<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ServsicPV.Converters">

    <!-- Conversores -->
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <conv:NullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" Invert="True" />
    <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
    <conv:CurrencyConverter x:Key="CurrencyConverter" />
    <conv:StatusColorConverter x:Key="StatusColorConverter" />
    <conv:NotificationBackgroundConverter x:Key="NotificationBackgroundConverter" />
    <conv:NotificationBorderConverter x:Key="NotificationBorderConverter" />
    <conv:InverseBoolConverter x:Key="InverseBoolConverter" />

    <!-- Cores do Design System ServSic (Exclusivamente Claro e Azul) -->
    <Color x:Key="ColorServsicDark">#0B192C</Color>
    <Color x:Key="ColorServsicNavyLight">#1E293B</Color>
    <Color x:Key="ColorServsicBlue">#0284C7</Color>
    <Color x:Key="ColorServsicBlueHover">#0369A1</Color>
    <Color x:Key="ColorServsicBlueLight">#38BDF8</Color>
    <Color x:Key="ColorServsicBlueSoft">#E0F2FE</Color>
    <!-- Menta EXCLUSIVO para o logo 'serve' em CompuServe -->
    <Color x:Key="ColorServsicMint">#00D2C4</Color>
    <Color x:Key="ColorIceBackground">#F8FAFC</Color>
    <Color x:Key="ColorCardBackground">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#E2E8F0</Color>
    <Color x:Key="ColorBorderHover">#0284C7</Color>
    <Color x:Key="ColorTextDark">#0F172A</Color>
    <Color x:Key="ColorTextSubtle">#64748B</Color>
    <Color x:Key="ColorDanger">#EF4444</Color>
    <Color x:Key="ColorSuccess">#10B981</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>

    <!-- Pincéis (Brushes) -->
    <SolidColorBrush x:Key="BrushServsicDark" Color="{StaticResource ColorServsicDark}" />
    <SolidColorBrush x:Key="BrushServsicNavyLight" Color="{StaticResource ColorServsicNavyLight}" />
    <SolidColorBrush x:Key="BrushServsicBlue" Color="{StaticResource ColorServsicBlue}" />
    <SolidColorBrush x:Key="BrushCorporateBlue" Color="{StaticResource ColorServsicBlue}" />
    <SolidColorBrush x:Key="BrushServsicBlueHover" Color="{StaticResource ColorServsicBlueHover}" />
    <SolidColorBrush x:Key="BrushServsicBlueLight" Color="{StaticResource ColorServsicBlueLight}" />
    <SolidColorBrush x:Key="BrushServsicBlueSoft" Color="{StaticResource ColorServsicBlueSoft}" />
    <!-- Menta estritamente para o logo CompuServe -->
    <SolidColorBrush x:Key="BrushServsicMint" Color="{StaticResource ColorServsicMint}" />
    <!-- Compatibilidade legada apontando para Azul Claro -->
    <SolidColorBrush x:Key="BrushServsicMintLight" Color="{StaticResource ColorServsicBlueLight}" />
    <SolidColorBrush x:Key="BrushIceBackground" Color="{StaticResource ColorIceBackground}" />
    <SolidColorBrush x:Key="BrushBackgroundIce" Color="{StaticResource ColorIceBackground}" />
    <SolidColorBrush x:Key="BrushCardBackground" Color="{StaticResource ColorCardBackground}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderHover" Color="{StaticResource ColorBorderHover}" />
    <SolidColorBrush x:Key="BrushTextDark" Color="{StaticResource ColorTextDark}" />
    <SolidColorBrush x:Key="BrushTextSubtle" Color="{StaticResource ColorTextSubtle}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />

    <!-- Tipografia e Estilos de Texto -->
    <Style x:Key="TextHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextDark}" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="TextSubheader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSubtle}" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <Style x:Key="TextLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextDark}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Estilos de Botões -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushServsicBlue}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="BtnAccentBlue" TargetType="Button">
        <Setter Property="Background" Value="#0369A1" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- BtnMint redefinido para Azul caso haja qualquer componente remanescente -->
    <Style x:Key="BtnMint" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushServsicBlue}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="BtnSecondary" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextDark}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushDanger}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

</ResourceDictionary>
